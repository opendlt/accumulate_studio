{
  "name": "accumulate-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Accumulate Protocol Developer Onboarding Platform - Transformational Developer Onboarding Experience",
  "workspaces": [
    "apps/*",
    "packages/*",
    "templates"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/studio",
    "dev:mcp": "npm run dev --workspace=apps/mcp-server",
    "build": "npm run build --workspaces --if-present",
    "build:studio": "npm run build --workspace=apps/studio",
    "build:mcp": "npm run build --workspace=apps/mcp-server",
    "build:types": "npm run build --workspace=packages/types",
    "build:verification": "npm run build --workspace=packages/verification",
    "build:codegen": "npm run build --workspace=packages/codegen",
    "build:agent-pack": "npm run build --workspace=packages/agent-pack",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "rimraf **/dist **/node_modules/.cache",
    "dev:proxy": "cd apps/sdk-proxy && python -m uvicorn app.main:app --reload --port 8000",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:proxy\"",
    "install:proxy": "cd apps/sdk-proxy && pip install -e .",
    "validate:manifests": "npx tsx scripts/check-manifest-drift.ts",
    "validate:canonical": "npx tsx scripts/check-canonical-coverage.ts",
    "gen:agent": "node scripts/generate-agent-artifacts.mjs",
    "gen:agent:dist": "node scripts/generate-agent-artifacts.mjs --dist",
    "verify:artifacts": "node tools/artifact-verify/verify.mjs --out docs/ai-agent-readiness/artifact-verify.json",
    "verify:scorecard": "node tools/agent-harness/scorecard.mjs",
    "harness:list": "node tools/agent-harness/runner.mjs --list",
    "harness:selftest": "node tools/agent-harness/runner.mjs --self-test",
    "harness:test": "node --test tools/agent-harness/test/harness.test.mjs",
    "harness:preflight": "node tools/agent-harness/runner.mjs --lang all --preflight --backend claude-code",
    "harness:run": "node tools/agent-harness/runner.mjs --lang all --tasks all --mode sdk --backend claude-code --concurrency 4 --provision-concurrency 1",
    "gen:mcp": "node scripts/generate-mcp-content.mjs",
    "test:mcp": "node --test apps/mcp-server/test/protocol.test.mjs",
    "test:lsp": "node --test tools/agent-lsp/test/parsers.test.mjs tools/agent-lsp/test/lsp-client.test.mjs",
    "build:headless": "node scripts/build-headless.mjs",
    "studio:headless": "node tools/studio-headless/dist/studio-headless.mjs",
    "verify:codegen": "node scripts/build-headless.mjs && node tools/studio-headless/dist/studio-headless.mjs --all",
    "harness:clean": "node tools/agent-harness/runner.mjs --clean-cache",
    "verify:cli": "node tools/cli-conformance/all.mjs"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "pyright": "^1.1.411",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.3",
    "typescript-language-server": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "accumulate",
    "blockchain",
    "developer-tools",
    "onboarding",
    "visual-builder",
    "code-generation",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/accumulate/accumulate-studio"
  },
  "license": "MIT"
}
