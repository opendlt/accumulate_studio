# =============================================================================
# Accumulate Studio - .gitignore
# =============================================================================

# ── Dependencies ──
node_modules/

# ── Build outputs ──
**/dist/
*.tsbuildinfo

# ── TypeScript composite build artifacts in source trees ──
# (tsc with composite:true emits .js/.d.ts/.map alongside .tsx sources)
apps/studio/src/**/*.js
apps/studio/src/**/*.js.map
apps/studio/src/**/*.d.ts
apps/studio/src/**/*.d.ts.map
# …but vite-env.d.ts is a hand-written ambient declaration (import.meta.env types),
# not build output — it MUST be committed or the Vercel build's tsc fails (TS2339).
!apps/studio/src/vite-env.d.ts

# ── Vite ──
.vite/

# ── Environment variables ──
.env.*.local

# ── Test harness build artifacts ──
# Rust (can be 3+ GB)
packages/codegen/tests/rust-harness/target/
# C# build outputs
packages/codegen/tests/csharp-harness/bin/
packages/codegen/tests/csharp-harness/bin-gen/
packages/codegen/tests/csharp-harness/obj/
# Dart
packages/codegen/tests/dart-harness/.dart_tool/
# JS harness deps
packages/codegen/tests/js-harness/node_modules/

# ── Test snapshots & generated output ──
# __snapshots__/ holds committed golden snapshots (codegen-snapshots.test.ts) — version-controlled on purpose.
packages/codegen/tests/action-palette-output/
packages/codegen/tests/snapshots/

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.Python
.venv/
venv/
.pytest_cache/

# ── Vercel CLI ──
.vercel/

# ── Temp / generated downloads ──
temp-download-*/
output/

# ── Lock files (non-root) ──
# Root package-lock.json IS committed; these are test harness locks
packages/codegen/tests/rust-harness/Cargo.lock
packages/codegen/tests/dart-harness/pubspec.lock

# ── IDE / Editor ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS artifacts ──
.DS_Store
Thumbs.db
nul
*.bak

# ── Claude Code local settings ──
.claude/

# ── Logs ──
*.log
npm-debug.log*
config.bat
*.stackdump
apps/studio/.env.development
