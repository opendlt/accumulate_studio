# SDK Proxy URL.
#
# PRODUCTION: leave this EMPTY. The studio then calls the proxy same-origin at
# /api/* and Vercel's rewrite forwards those to the HTTPS proxy. A non-empty
# value here would make the browser fetch the proxy directly and trigger a
# mixed-content block on an HTTPS page.
#
# LOCAL DEV: set to http://localhost:8000 (see .env.development).
VITE_SDK_PROXY_URL=
