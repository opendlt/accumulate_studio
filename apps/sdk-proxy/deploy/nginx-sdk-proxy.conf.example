# nginx reverse-proxy + TLS for the Accumulate SDK proxy.
#
# Use this on a host where nginx already terminates TLS for other sites (the
# common case). The proxy container listens on 127.0.0.1:8000 (see
# docker-compose.yml); nginx terminates TLS and forwards /api/* to it.
#
# Install:
#   cp deploy/nginx-sdk-proxy.conf.example /etc/nginx/sites-available/116-202-214-38.sslip.io
#   ln -s /etc/nginx/sites-available/116-202-214-38.sslip.io /etc/nginx/sites-enabled/
#   certbot --nginx -d 116-202-214-38.sslip.io     # adds the listen 443 ssl + cert lines
#   nginx -t && systemctl reload nginx
#
# PROXY_DOMAIN defaults to an sslip.io name that resolves to the host's public
# IP, so no custom domain is required. Replace it everywhere if you own a domain.

server {
    listen 80;
    listen [::]:80;
    server_name 116-202-214-38.sslip.io;

    # Forward the studio's API traffic to the proxy. The leftmost X-Forwarded-For
    # entry (set upstream by Vercel) is the real client, which the proxy uses for
    # per-user rate limiting.
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location / {
        return 404;
    }
}
