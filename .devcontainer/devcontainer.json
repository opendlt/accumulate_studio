{
  "name": "accumulate-studio",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bookworm",

  "features": {
    // Studio genuinely needs both runtimes: the web app and codegen are Node,
    // while apps/sdk-proxy is a FastAPI/uvicorn service installed with pip.
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11",
      "installTools": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // `bsdtar` is not optional: tools/artifact-verify unpacks published .nupkg and
  // .crate archives to verify what actually shipped. Without it those checks skip
  // and the scorecard silently under-reports.
  "onCreateCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends libarchive-tools unzip",

  // Ordering is load-bearing. packages/types must build before any dependent
  // workspace, and the proxy install is a separate Python toolchain.
  "postCreateCommand": "npm ci && npm run build:types && npm run install:proxy",

  "containerEnv": {
    // Testnet by default; mainnet is never selected implicitly. The MCP server
    // reads this and falls back to testnet on an unknown value.
    "ACCUMULATE_NETWORK": "kermit",
    "ACCUMULATE_MCP_PERMISSION": "BUILD_ONLY"
  },

  "forwardPorts": [5173, 8000],
  "portsAttributes": {
    "5173": { "label": "Studio (Vite)", "onAutoForward": "notify" },
    "8000": { "label": "sdk-proxy (uvicorn)", "onAutoForward": "silent" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-python.python"
      ]
    }
  },

  // remoteUser is root deliberately.
  //
  // Verified on Docker Desktop for Windows: bind-mounted workspace files are
  // presented as root:root, `chown` on them fails, and a non-root user cannot
  // call utime on them. Every command these containers are built to run writes
  // into the workspace (`dart pub get` touches pubspec.lock, `pip install -e .`
  // writes egg-info, `npm ci` writes node_modules, `cargo build` writes target/,
  // `dotnet restore` writes obj/), so a non-root remoteUser made `dart test`
  // fail with "Operation not permitted" before running a single test.
  //
  // The isolation boundary here is the CONTAINER, not the in-container user: the
  // only host path mounted is the workspace, and no credentials are baked in. On
  // a Linux or macOS host, prefer the image's non-root user instead — there the
  // bind mount carries real ownership and root would leave root-owned files on
  // the host.
  "remoteUser": "root"
}
