{{#if hashLock}}
    // =========================================================
    // {{label}} (Action: SendTokens, hash-locked)
    // =========================================================
    // Hash-locked send: the sender is debited now and the recipient is credited only
    // when a ReleaseLockedOperation reveals the preimage. The lock rides in the
    // transaction header, so the `_with_options` variant is required.
    let mut {{varName}}_signer = SmartSigner::new(&client, {{keyVarName}}_signer.clone(), {{#if signerUrlIsRef}}&{{signerUrl}}{{else}}{{signerUrl}}{{/if}});
    let {{varName}}_options = HeaderOptions { hash_lock: Some({{hashLockVar}}_lock.clone()), ..Default::default() };
    let {{varName}}_result = {{varName}}_signer.sign_submit_and_wait_with_options(
        {{#if sendTokensPrincipalIsRef}}&{{sendTokensPrincipal}}{{else}}"{{sendTokensPrincipal}}"{{/if}},
        &TxBody::send_tokens_single({{#if firstRecipientUrlIsRef}}&{{firstRecipientUrl}}{{else}}"{{firstRecipientUrl}}"{{/if}}, {{#if firstRecipientAmountIsRef}}&{{firstRecipientAmount}}{{else}}"{{firstRecipientAmount}}"{{/if}}),
        &{{varName}}_options,
        30,
    ).await;
    let {{varName}}_txid = confirm(&client, "SendTokens (hash-locked)", &{{varName}}_result).await;
    println!("SendTokens LOCKED - TxID: {}", {{varName}}_txid);
    tx_ids.push(("SendTokens (hash-locked)", {{varName}}_txid.clone()));
{{else}}
    // =========================================================
    // {{label}} (Action: SendTokens)
    // =========================================================
    let mut {{varName}}_signer = SmartSigner::new(&client, {{keyVarName}}_signer.clone(), {{#if signerUrlIsRef}}&{{signerUrl}}{{else}}{{signerUrl}}{{/if}});
{{#if singleRecipient}}
    let {{varName}}_result = {{varName}}_signer.sign_submit_and_wait(
        {{#if sendTokensPrincipalIsRef}}&{{sendTokensPrincipal}}{{else}}"{{sendTokensPrincipal}}"{{/if}},
        &TxBody::send_tokens_single({{#if firstRecipientUrlIsRef}}&{{firstRecipientUrl}}{{else}}"{{firstRecipientUrl}}"{{/if}}, {{#if firstRecipientAmountIsRef}}&{{firstRecipientAmount}}{{else}}"{{firstRecipientAmount}}"{{/if}}),
        Some("Send tokens"),
        30,
    ).await;
{{else}}
    let {{varName}}_result = {{varName}}_signer.sign_submit_and_wait(
        {{#if sendTokensPrincipalIsRef}}&{{sendTokensPrincipal}}{{else}}"{{sendTokensPrincipal}}"{{/if}},
        &TxBody::send_tokens_multi(&[
{{#each recipientsAnnotated}}
            ({{#if this.urlIsRef}}&{{this.url}}{{else}}"{{this.url}}"{{/if}}, {{#if this.amountIsRef}}&{{this.amount}}{{else}}"{{this.amount}}"{{/if}}),
{{/each}}
        ]),
        Some("Send tokens"),
        30,
    ).await;
{{/if}}
    if {{varName}}_result.success {
        println!("SendTokens SUCCESS - TxID: {:?}", {{varName}}_result.txid);
        if let Some(ref txid) = {{varName}}_result.txid {
            tx_ids.push(("SendTokens", txid.clone()));
        }
    } else {
        println!("SendTokens FAILED: {:?}", {{varName}}_result.error);
    }{{/if}}