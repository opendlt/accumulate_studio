{{#if hashLock}}
        # =========================================================
        # {{label}} (Action: SendTokens, hash-locked)
        # =========================================================
        # Hash-locked send: the sender is debited now and the recipient is credited only
        # when a ReleaseLockedOperation reveals the preimage.
        {{varName}}_signer = SmartSigner(client.v3, {{keyVarName}}_kp, {{signerUrl}})
        {{varName}}_result = {{varName}}_signer.sign_submit_and_wait(
            principal={{#if sendTokensPrincipalIsRef}}{{sendTokensPrincipal}}{{else}}"{{sendTokensPrincipal}}"{{/if}},
            body=TxBody.send_tokens_single(
                to_url={{#if firstRecipientUrlIsRef}}{{firstRecipientUrl}}{{else}}"{{firstRecipientUrl}}"{{/if}},
                amount={{#if firstRecipientAmountIsRef}}{{firstRecipientAmount}}{{else}}"{{firstRecipientAmount}}"{{/if}},
            ),
            hash_lock={{hashLockVar}}_lock,
            max_attempts=45,
        )
        if not {{varName}}_result.success:
            print(f"SendTokens (hash-locked) FAILED: { {{~varName}}_result.error}")
            sys.exit(1)
        {{varName}}_txid = {{varName}}_result.txid
        print(f"SendTokens LOCKED - TxID: { {{~varName}}_txid}")
        tx_ids.append(("SendTokens (hash-locked)", {{varName}}_txid))
{{else}}
        # =========================================================
        # {{label}} (Action: SendTokens)
        # =========================================================
        {{varName}}_signer = SmartSigner(client.v3, {{keyVarName}}_kp, {{signerUrl}})
{{#if singleRecipient}}
        {{varName}}_result = {{varName}}_signer.sign_submit_and_wait(
            principal={{#if sendTokensPrincipalIsRef}}{{sendTokensPrincipal}}{{else}}"{{sendTokensPrincipal}}"{{/if}},
            body=TxBody.send_tokens_single(
                to_url={{#if firstRecipientUrlIsRef}}{{firstRecipientUrl}}{{else}}"{{firstRecipientUrl}}"{{/if}},
                amount={{#if firstRecipientAmountIsRef}}{{firstRecipientAmount}}{{else}}"{{firstRecipientAmount}}"{{/if}},
            ),
            max_attempts=30,
        )
{{else}}
        {{varName}}_result = {{varName}}_signer.sign_submit_and_wait(
            principal={{#if sendTokensPrincipalIsRef}}{{sendTokensPrincipal}}{{else}}"{{sendTokensPrincipal}}"{{/if}},
            body=TxBody.send_tokens(
                recipients=[
{{#each recipientsAnnotated}}
                    {"url": {{#if this.urlIsRef}}{{this.url}}{{else}}"{{this.url}}"{{/if}}, "amount": {{#if this.amountIsRef}}{{this.amount}}{{else}}"{{this.amount}}"{{/if}} },
{{/each}}
                ],
            ),
            max_attempts=30,
        )
{{/if}}
        if {{varName}}_result.success:
            print(f"SendTokens SUCCESS - TxID: { {{~varName}}_result.txid}")
            tx_ids.append(("SendTokens", {{varName}}_result.txid))
        else:
            print(f"SendTokens FAILED: { {{~varName}}_result.error}"){{/if}}