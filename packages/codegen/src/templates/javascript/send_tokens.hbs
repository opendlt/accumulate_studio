{{#if hashLock}}
        // =========================================================
        // {{label}} (SendTokens, hash-locked)
        // =========================================================
        // Hash-locked send: the sender is debited now and the recipient is credited only
        // when a ReleaseLockedOperation reveals the preimage.
        const {{varName}}Signer = new SmartSigner(client, {{keyVarName}}Kp.toKey(), {{signerUrl}});
        const {{varName}}TxId = await submitAndConfirm(
            client,
            "SendTokens (hash-locked)",
            {{varName}}Signer,
            {{#if sendTokensPrincipalIsRef}}{{sendTokensPrincipal}}{{else}}"{{sendTokensPrincipal}}"{{/if}},
            TxBody.sendTokensSingle(
                {{#if firstRecipientUrlIsRef}}{{firstRecipientUrl}}{{else}}"{{firstRecipientUrl}}"{{/if}},
                {{#if firstRecipientAmountIsRef}}{{firstRecipientAmount}}{{else}}"{{firstRecipientAmount}}"{{/if}},
            ),
            { hashLock: {{hashLockVar}}Lock },
        );
        console.log(`SendTokens LOCKED - TxID: ${ {{~varName}}TxId}`);
        txIds.push(["SendTokens (hash-locked)", {{varName}}TxId]);
{{else}}
        // =========================================================
        // {{label}} (Action: SendTokens)
        // =========================================================
        const {{varName}}Signer = new SmartSigner(client, {{keyVarName}}Kp.toKey(), {{signerUrl}});
{{#if singleRecipient}}
        const {{varName}}Result = await {{varName}}Signer.signSubmitAndWait(
            {{#if sendTokensPrincipalIsRef}}{{sendTokensPrincipal}}{{else}}"{{sendTokensPrincipal}}"{{/if}},
            TxBody.sendTokensSingle(
                {{#if firstRecipientUrlIsRef}}{{firstRecipientUrl}}{{else}}"{{firstRecipientUrl}}"{{/if}},
                {{#if firstRecipientAmountIsRef}}{{firstRecipientAmount}}{{else}}"{{firstRecipientAmount}}"{{/if}},
            ),
        );
{{else}}
        const {{varName}}Result = await {{varName}}Signer.signSubmitAndWait(
            {{#if sendTokensPrincipalIsRef}}{{sendTokensPrincipal}}{{else}}"{{sendTokensPrincipal}}"{{/if}},
            TxBody.sendTokensMulti([
{{#each recipientsAnnotated}}
                { url: {{#if this.urlIsRef}}{{this.url}}{{else}}"{{this.url}}"{{/if}}, amount: {{#if this.amountIsRef}}{{this.amount}}{{else}}"{{this.amount}}"{{/if}} },
{{/each}}
            ]),
        );
{{/if}}
        if ({{varName}}Result.success) {
            console.log(`SendTokens SUCCESS - TxID: ${ {{~varName}}Result.txid}`);
            if ({{varName}}Result.txid) txIds.push(["SendTokens", {{varName}}Result.txid]);
        } else {
            console.log(`SendTokens FAILED: ${ {{~varName}}Result.error}`);
        }
{{/if}}