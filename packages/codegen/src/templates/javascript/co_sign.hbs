        // =========================================================
        // {{label}} (Action: CoSign — {{coSignOperation}} under an M-of-N threshold)
        // =========================================================
        // A threshold needs DISTINCT keys signing the SAME transaction. Signing the
        // body twice does not work: the first signature's metadata becomes the
        // transaction's `initiator` and is baked into the header, so a second
        // independent signature is over a different transaction hash and neither
        // copy reaches the threshold. Co-sign the existing envelope instead.
        const {{varName}}Body = {{{coSignBodyExpr}}};
        const {{varName}}Signer = new SmartSigner(client, {{keyVarName}}Kp.toKey(), {{signerUrl}});
        let {{varName}}Envelope = (await {{varName}}Signer.sign({{{coSignPrincipal}}}, {{varName}}Body)).envelope;
{{#each coSignExtraSigners}}
        // Co-signer {{@index}}: appends a signature to the SAME transaction hash.
        {{../varName}}Envelope = await new SmartSigner(client, {{this.key}}Kp.toKey(), {{this.signerUrl}})
            .signExisting({{../varName}}Envelope);
{{/each}}
        // Submit only once every signature is collected: resubmitting a signature
        // that is already on chain trips replay protection.
        // execute() throws on a rejected envelope, so reaching the next line means
        // the network accepted it.
        // execute() serialises the Envelope itself — passing asObject() here would
        // hand it a plain object it cannot re-serialise.
        const {{varName}}Result = await client.v2.execute({{varName}}Envelope);
        const {{varName}}Txid = {{varName}}Result.txid.toString();
        // Acceptance is not execution. A transaction that has not reached its
        // threshold is accepted and then sits pending, so the only honest
        // confirmation is the delivered status.
        let {{varName}}Status = 'unknown';
        for (let i = 0; i < 30; i++) {
            try {
                const { status } = await client.v2.queryTx({{varName}}Txid);
                {{varName}}Status = status?.code ?? 'unknown';
                if ({{varName}}Status !== 'pending' && {{varName}}Status !== 'remote') break;
            } catch { /* not indexed yet */ }
            await new Promise((r) => setTimeout(r, 2000));
        }
        if ({{varName}}Status === 'delivered') {
            console.log(`CoSign {{coSignOperation}} DELIVERED with {{coSignSignerCount}} signature(s) - TxID: ${ {{~varName}}Txid}`);
        } else {
            console.log(`CoSign {{coSignOperation}} NOT DELIVERED (status=${ {{~varName}}Status}) - TxID: ${ {{~varName}}Txid}`);
        }
