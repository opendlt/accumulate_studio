"#!/usr/bin/env python3
"""
Zero to Hero: From Nothing to ADI
=================================

Generated by Accumulate Studio
Network: devnet
"""

import time

from accumulate_client import Accumulate, NetworkStatusOptions
from accumulate_client.convenience import TxBody, SmartSigner
from accumulate_client.crypto.ed25519 import Ed25519KeyPair
import hashlib
import requests as _requests_lib

# Network endpoints
NETWORK_ENDPOINT = "https://devnet.accumulatenetwork.io"
# For local DevNet testing, uncomment:
# NETWORK_ENDPOINT = "http://127.0.0.1:26660"


def fund_account(client, account_url, faucet_requests=1):
    """Fund an account using the testnet faucet with retry logic."""
    v2_endpoint = client.v2.endpoint
    print(f"Requesting funds from faucet ({faucet_requests} times)...")
    for i in range(faucet_requests):
        try:
            response = _requests_lib.post(
                v2_endpoint,
                json={
                    "jsonrpc": "2.0",
                    "method": "faucet",
                    "params": {"url": account_url},
                    "id": i + 1,
                },
                timeout=30,
            )
            result = response.json()
            txid = result.get("result", {}).get("txid", "submitted")
            print(f"  Faucet {i+1}/{faucet_requests}: {str(txid)[:40]}...")
            time.sleep(2)
        except Exception as e:
            print(f"  Faucet {i+1}/{faucet_requests} failed: {e}")


def poll_for_balance(client, account_url, min_balance=1, max_attempts=30):
    """Poll until account balance meets minimum threshold."""
    for i in range(max_attempts):
        try:
            result = client.v3.query(account_url)
            balance = result.get("account", {}).get("balance")
            if balance is not None:
                balance_int = int(balance) if isinstance(balance, (int, str)) else 0
                if balance_int > 0 and balance_int >= min_balance:
                    return balance_int
            print(f"  Waiting for balance... (attempt {i+1}/{max_attempts})")
        except Exception:
            pass
        time.sleep(2)
    return 0


def poll_for_credits(client, account_url, min_credits=1, max_attempts=30):
    """Poll until account credit balance meets minimum threshold."""
    for i in range(max_attempts):
        try:
            result = client.v3.query(account_url)
            credits = result.get("account", {}).get("creditBalance", 0)
            if int(credits) > 0 and int(credits) >= min_credits:
                return int(credits)
            print(f"  Waiting for credits... (attempt {i+1}/{max_attempts})")
        except Exception:
            pass
        time.sleep(2)
    return 0


def main():
    """
    Zero to Hero: From Nothing to ADI
    Complete beginner flow that takes you from zero to a fully functional ADI. Generates keys, funds a lite account via faucet, adds credits, creates an ADI, and sets up a token account. Perfect for first-time users.

    Generated by Accumulate Studio
    """

    # Connect to the network
    client = Accumulate(NETWORK_ENDPOINT)
    tx_ids = []

    # Flow variables (customize these for your use case)
    adi_name = f"adi-{int(time.time())}"  # 
    token_account_name = ""  # 

    try:


        # =========================================================
        # GenerateKeys (Action: GenerateKeys)
        # =========================================================
        generate_keys_kp = Ed25519KeyPair.generate()
        generate_keys_lid = generate_keys_kp.derive_lite_identity_url()
        generate_keys_lta = generate_keys_kp.derive_lite_token_account_url("ACME")
        generate_keys_pub_hash = hashlib.sha256(generate_keys_kp.public_key_bytes()).hexdigest()
        print(f"Generated keypair:")
        print(f"  Lite Identity: {generate_keys_lid}")
        print(f"  Lite Token Account: {generate_keys_lta}")

        # =========================================================
        # Faucet (Action: Faucet)
        # =========================================================
        fund_account(client, str(generate_keys_lta), faucet_requests=2)
        print("Faucet request completed")

        # =========================================================
        # WaitForBalance (Action: WaitForBalance)
        # =========================================================
        print("Waiting for balance >= 10.00000000...")
        _balance = poll_for_balance(client, str(generate_keys_lta), min_balance=10.00000000)
        if _balance == 0:
            print("ERROR: Balance did not reach minimum. Stopping.")
            return
        print(f"Balance confirmed: {_balance}")

        # =========================================================
        # AddCredits (Action: AddCredits)
        # =========================================================
        add_credits_oracle = client.v3.network_status(
            NetworkStatusOptions(partition="directory")
        ).get("oracle", {}).get("price", 500000)
        print(f"Oracle price: {add_credits_oracle}")
        add_credits_signer = SmartSigner(client.v3, generate_keys_kp, generate_keys_lid)
        add_credits_result = add_credits_signer.sign_submit_and_wait(
            principal=str(generate_keys_lta),
            body=TxBody.add_credits(
                recipient=str(generate_keys_lid),
                amount="500000000",
                oracle=add_credits_oracle,
            ),
            max_attempts=30,
        )
        if add_credits_result.success:
            print(f"AddCredits SUCCESS - TxID: {add_credits_result.txid}")
            tx_ids.append(("AddCredits", add_credits_result.txid))
        else:
            print(f"AddCredits FAILED: {add_credits_result.error}")

        # =========================================================
        # WaitForCredits (Action: WaitForCredits)
        # =========================================================
        print("Waiting for credits >= 1000...")
        _credits = poll_for_credits(client, str(generate_keys_lid), min_credits=1000)
        if _credits == 0:
            print("ERROR: Credits did not reach minimum. Stopping.")
            return
        print(f"Credits confirmed: {_credits}")

        # =========================================================
        # CreateIdentity (Action: CreateIdentity)
        # =========================================================
        create_identity_url = f"acc://{adi_name}.acme"
        create_identity_signer = SmartSigner(client.v3, generate_keys_kp, generate_keys_lid)
        create_identity_result = create_identity_signer.sign_submit_and_wait(
            principal=str(generate_keys_lta),
            body=TxBody.create_identity(
                url=create_identity_url,
                key_book_url=f"{create_identity_url}/book",
                public_key_hash=generate_keys_pub_hash,
            ),
            max_attempts=30,
        )
        if create_identity_result.success:
            print(f"CreateIdentity SUCCESS - TxID: {create_identity_result.txid}")
            tx_ids.append(("CreateIdentity", create_identity_result.txid))
        else:
            print(f"CreateIdentity FAILED: {create_identity_result.error}")

        # =========================================================
        # CreateTokenAccount (Action: CreateTokenAccount)
        # =========================================================
        create_token_account_url = f"acc://{adi_name}.acme/{token_account_name}"
        create_token_account_signer = SmartSigner(client.v3, generate_keys_kp, f"{str(create_identity_url)}/book/1")
        create_token_account_result = create_token_account_signer.sign_submit_and_wait(
            principal=f"acc://{adi_name}.acme",
            body=TxBody.create_token_account(
                url=create_token_account_url,
                token_url="acc://ACME",
            ),
            max_attempts=30,
        )
        if create_token_account_result.success:
            print(f"CreateTokenAccount SUCCESS - TxID: {create_token_account_result.txid}")
            tx_ids.append(("CreateTokenAccount", create_token_account_result.txid))
        else:
            print(f"CreateTokenAccount FAILED: {create_token_account_result.error}")

        # =========================================================
        # Summary
        # =========================================================
        print("\\n=== TRANSACTION IDs FOR VERIFICATION ===\\n")
        for tx_name, txid in tx_ids:
            print(f"  {tx_name}: {txid}")
        print(f"\\nTotal transactions: {len(tx_ids)}")
        print("Flow completed successfully!")

    finally:
        client.close()


if __name__ == "__main__":
    main()
"
