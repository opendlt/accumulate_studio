            // =========================================================
            var setThresholdSigner = new SmartSigner(client.V3, setThresholdKp, setThresholdLid.String());
            var setThresholdResult = await setThresholdSigner.SignSubmitAndWaitAsync(
                $"{adi_url}/{key_book_name}/1",
                TxBody.UpdateKeyPage(new List<Dictionary<string, object?>>
                {
                    new Dictionary<string, object?> { ["type"] = "setThreshold", ["threshold"] = "threshold" }
                })
            );
            if (setThresholdResult.Success)
            {
                Console.WriteLine($"UpdateKeyPage SUCCESS - TxID: {setThresholdResult.TxId}");
                if (setThresholdResult.TxId != null) txIds.Add(("UpdateKeyPage", setThresholdResult.TxId));
            }
            else
            {
                Console.WriteLine($"UpdateKeyPage FAILED: {setThresholdResult.Error}");
            }


            Console.WriteLine("\\n========== Transaction Summary ==========");
            foreach (var (label, txid) in txIds)
            {
                Console.WriteLine($"  {label}: {txid}");
            }
            Console.WriteLine("Flow completed successfully!");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Flow failed: {ex.Message}");
        }
    }
}
"
