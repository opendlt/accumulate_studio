"#!/usr/bin/env python3
"""
Key Rotation
============

Generated by Accumulate Studio
Network: devnet
"""

import time

from accumulate_client import Accumulate, NetworkStatusOptions
from accumulate_client.convenience import TxBody, SmartSigner
from accumulate_client.crypto.ed25519 import Ed25519KeyPair
import hashlib

# Network endpoints
NETWORK_ENDPOINT = "https://devnet.accumulatenetwork.io"
# For local DevNet testing, uncomment:
# NETWORK_ENDPOINT = "http://127.0.0.1:26660"


def main():
    """
    Key Rotation
    Security best practice for rotating keys. Generates a new keypair and updates the key page to use the new key, replacing the old one. Important for maintaining security over time.

    Generated by Accumulate Studio
    """

    # Connect to the network
    client = Accumulate(NETWORK_ENDPOINT)
    tx_ids = []

    # Flow variables (customize these for your use case)
    key_page_url = ""  # 
    old_public_key_hash = ""  # 

    try:


        # =========================================================
        # GenerateKeys (Action: GenerateKeys)
        # =========================================================
        generate_new_keys_kp = Ed25519KeyPair.generate()
        generate_new_keys_lid = generate_new_keys_kp.derive_lite_identity_url()
        generate_new_keys_lta = generate_new_keys_kp.derive_lite_token_account_url("ACME")
        generate_new_keys_pub_hash = hashlib.sha256(generate_new_keys_kp.public_key_bytes()).hexdigest()
        print(f"Generated keypair:")
        print(f"  Lite Identity: {generate_new_keys_lid}")
        print(f"  Lite Token Account: {generate_new_keys_lta}")

        # =========================================================
        # UpdateKey (Action: UpdateKey → UpdateKeyPage remove+add)
        # =========================================================
        # The SDK doesn't support updateKey natively, so we use
        # updateKeyPage with remove(old) + add(new) operations.
        update_key_old_key_hash = hashlib.sha256(generate_new_keys_kp.public_key_bytes()).digest()
        update_key_new_key_hash = bytes.fromhex(generate_new_keys_pub_hash)
        update_key_signer = SmartSigner(client.v3, generate_new_keys_kp, generate_new_keys_lid)
        update_key_result = update_key_signer.sign_submit_and_wait(
            principal=key_page_url,
            body=TxBody.update_key_page([
                TxBody.remove_key_operation(update_key_old_key_hash),
                TxBody.add_key_operation(update_key_new_key_hash),
            ]),
            max_attempts=30,
        )
        if update_key_result.success:
            print(f"UpdateKey SUCCESS - TxID: {update_key_result.txid}")
            tx_ids.append(("UpdateKey", update_key_result.txid))
        else:
            print(f"UpdateKey FAILED: {update_key_result.error}")

        # =========================================================
        # QueryAccount (Action: QueryAccount)
        # =========================================================
        verify_key_page_result = client.v3.query(key_page_url)
        print(f"Account state: {verify_key_page_result}")

        # =========================================================
        # Summary
        # =========================================================
        print("\\n=== TRANSACTION IDs FOR VERIFICATION ===\\n")
        for tx_name, txid in tx_ids:
            print(f"  {tx_name}: {txid}")
        print(f"\\nTotal transactions: {len(tx_ids)}")
        print("Flow completed successfully!")

    finally:
        client.close()


if __name__ == "__main__":
    main()
