"//! Hash Lock (HTLC) Payment
//! ========================
//!
//! Generated by Accumulate Studio
//! Network: devnet

#[allow(unused_imports, unused_mut, non_snake_case)]
use accumulate_client::{
    AccumulateClient, AccOptions, SmartSigner, TxBody,
    derive_lite_identity_url, derive_lite_token_account_url,
};
use sha2::{Digest, Sha256};
use url::Url;
use serde_json::{json, Value};
use accumulate_client::generated::enums::HashAlgorithm;
use accumulate_client::{HeaderOptions, TxResult};

const NETWORK_V2: &str = "https://kermit.accumulatenetwork.io/v2";
const NETWORK_V3: &str = "https://kermit.accumulatenetwork.io/v3";

fn sha256_hash(data: &[u8]) -> String {
    let mut hasher = Sha256::new();
    hasher.update(data);
    hex::encode(hasher.finalize())
}

/// Print the reason and stop with a non-zero exit code: a failed HTLC step must never look like success.
fn fail(message: &str) -> ! {
    println!("FAILED: {}", message);
    std::process::exit(1)
}

/// Raw v3 \`query\` of an account URL or a transaction id.
async fn query(client: &AccumulateClient, scope: &str) -> Result<Value, Box<dyn std::error::Error>> {
    Ok(client.v3_client.call_v3::<Value>("query", json!({ "scope": scope })).await?)
}

/// \`TxResult::txid\` is NOT the transaction id: it is the id of the SIGNATURE message (the
/// second entry of the v3 submit response). The transaction id is the first entry's
/// \`status.txID\`. When a wait gives up the SDK returns no response, only "Timeout waiting
/// for delivery: <signature id>", so resolve the signature message to the transaction it signs.
async fn tx_id(client: &AccumulateClient, label: &str, res: &TxResult) -> Result<String, Box<dyn std::error::Error>> {
    if let Some(id) = res.response.as_ref().and_then(|r| r.get(0)).and_then(|e| e["status"]["txID"].as_str()) {
        return Ok(id.to_string());
    }
    let sig_id = res
        .error
        .as_deref()
        .and_then(|e| e.strip_prefix("Timeout waiting for delivery: "))
        .ok_or_else(|| format!("{}: {}", label, res.error.as_deref().unwrap_or("no txid")))?;
    let q = query(client, sig_id).await?;
    Ok(q["message"]["txID"].as_str().unwrap_or(sig_id).to_string())
}

/// The SDK wait helpers poll the signature message and treat any v3 string status other than
/// "delivered" (including a FAILED one such as "unauthenticated") as "keep polling", so a
/// failed transaction is reported as a success or a timeout. This polls the TRANSACTION itself
/// until it is final, stops the flow with the node's real error if it failed, and returns its id.
async fn confirm(client: &AccumulateClient, label: &str, res: &TxResult) -> String {
    let txid = match tx_id(client, label, res).await {
        Ok(id) => id,
        Err(e) => fail(&format!("{} failed: {}", label, e)),
    };
    let mut last = String::from("no response");
    for _ in 0..30 {
        match query(client, &txid).await {
            Ok(q) => {
                let status = q["status"].as_str().unwrap_or("unknown");
                let status_no = q["statusNo"].as_u64().unwrap_or(0);
                if status == "delivered" {
                    return txid;
                }
                if status_no >= 400 || !q["error"].is_null() {
                    let msg = q["error"]["message"].as_str().unwrap_or("no error message from node");
                    fail(&format!("{} {} failed: status '{}' (statusNo {}): {}", label, txid, status, status_no, msg));
                }
                last = format!("status '{}'", status);
            }
            Err(e) => last = e.to_string(),
        }
        tokio::time::sleep(std::time::Duration::from_secs(2)).await;
    }
    fail(&format!("{} {} did not finish: last {}", label, txid, last))
}

#[tokio::main]
async fn main() -> Result<(), Box<dyn std::error::Error>> {
    //
    // Hash Lock (HTLC) Payment
    // Locks tokens to a SHA-256 hash, finds the locked deposit, releases it by revealing the secret preimage and proves the receiver was credited. One ADI owns both accounts here; in a real swap the receiver is another party.

    // Generated by Accumulate Studio
    //

    // Connect to network (override with env vars for testing)
    let v2 = std::env::var("ACCUMULATE_V2_URL").unwrap_or_else(|_| NETWORK_V2.to_string());
    let v3 = std::env::var("ACCUMULATE_V3_URL").unwrap_or_else(|_| NETWORK_V3.to_string());
    let client = AccumulateClient::new_with_options(
        Url::parse(&v2)?, Url::parse(&v3)?, AccOptions::default()
    ).await?;

    let mut tx_ids: Vec<(&str, String)> = Vec::new();

    // Flow variables (customize these for your use case)
    let adi_name = format!("adi-{}-{:06x}", std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_secs(), std::hash::BuildHasher::hash_one(&std::collections::hash_map::RandomState::new(), 0u8) & 0xffffff);  // 
    let lock_amount = "100000000".to_string();  // 


    // =========================================================
    // GenerateKeys (Action: GenerateKeys)
    // =========================================================
    let generate_keys_signer = AccumulateClient::generate_keypair();
    let generate_keys_pub_key = generate_keys_signer.verifying_key().to_bytes();
    let generate_keys_pub_hash = sha256_hash(&generate_keys_pub_key);
    let generate_keys_lid = derive_lite_identity_url(&generate_keys_pub_key);
    let generate_keys_lta = derive_lite_token_account_url(&generate_keys_pub_key);
    println!("Generated keypair:");
    println!("  Lite Identity: {}", generate_keys_lid);
    println!("  Lite Token Account: {}", generate_keys_lta);
    println!("  Public Key Hash: {}", &generate_keys_pub_hash[..32]);

    // =========================================================
    // Faucet (Action: Faucet)
    // =========================================================
    println!("Requesting tokens from faucet...");
    let faucet_faucet_url = generate_keys_lta.to_string();
    for _i in 0..3 {
        let faucet_faucet_params = json!({ "account": faucet_faucet_url });
        match client.v3_client.call_v3::<Value>("faucet", faucet_faucet_params).await {
            Ok(response) => {
                let txid = response.get("transactionHash")
                    .or_else(|| response.get("txid"))
                    .and_then(|v| v.as_str())
                    .unwrap_or("submitted");
                println!("  Faucet: {}", txid);
            }
            Err(e) => {
                println!("  Faucet failed: {}", e);
            }
        }
        tokio::time::sleep(std::time::Duration::from_secs(2)).await;
    }
    println!("Faucet request completed");

    // =========================================================
    // WaitForBalance (Action: WaitForBalance)
    // =========================================================
    println!("Waiting for balance...");
    let wait_for_balance_scope = generate_keys_lta.to_string();
    let wait_for_balance_min_bal: u64 = "15.00000000".replace('.', "").parse().unwrap_or(10000000);
    for wait_for_balance_i in 0..30u32 {
        let wait_for_balance_params = json!({ "scope": wait_for_balance_scope, "query": { "queryType": "default" } });
        if let Ok(wait_for_balance_acct) = client.v3_client.call_v3::<Value>("query", wait_for_balance_params).await {
            if let Some(bal) = wait_for_balance_acct.get("account").and_then(|a| a.get("balance")).and_then(|b| b.as_str()) {
                if bal.parse::<u64>().unwrap_or(0) >= wait_for_balance_min_bal { break; }
            }
        } else {
            println!("  Account not found yet... (attempt {}/30)", wait_for_balance_i + 1);
        }
        tokio::time::sleep(std::time::Duration::from_secs(2)).await;
    }
    println!("Balance reached");

    // =========================================================
    // AddCredits (Action: AddCredits)
    // =========================================================
    let add_credits_oracle: Value = client.v3_client.call_v3("network-status", json!({})).await
        .unwrap_or_else(|_| json!({}));
    let add_credits_price = add_credits_oracle.get("oracle")
        .and_then(|o| o.get("price"))
        .and_then(|p| p.as_u64())
        .unwrap_or(50000000);
    let mut add_credits_signer = SmartSigner::new(&client, generate_keys_signer.clone(), &generate_keys_lid);
    let add_credits_result = add_credits_signer.sign_submit_and_wait(
        &generate_keys_lta,
        &TxBody::add_credits(&generate_keys_lid, "500000000", add_credits_price),
        Some("Add credits"),
        30,
    ).await;
    if add_credits_result.success {
        println!("AddCredits SUCCESS - TxID: {:?}", add_credits_result.txid);
        if let Some(ref txid) = add_credits_result.txid {
            tx_ids.push(("AddCredits", txid.clone()));
        }
    } else {
        println!("AddCredits FAILED: {:?}", add_credits_result.error);
    }

    // =========================================================
    // WaitForCredits (Action: WaitForCredits)
    // =========================================================
    println!("Waiting for credits...");
    let wait_for_credits_scope = generate_keys_lid.to_string();
    let wait_for_credits_min_cred: u64 = 1000;
    for wait_for_credits_i in 0..30u32 {
        let wait_for_credits_params = json!({ "scope": wait_for_credits_scope, "query": { "queryType": "default" } });
        if let Ok(wait_for_credits_acct) = client.v3_client.call_v3::<Value>("query", wait_for_credits_params).await {
            if let Some(cred) = wait_for_credits_acct.get("account").and_then(|a| a.get("creditBalance")).and_then(|c| c.as_u64()) {
                if cred >= wait_for_credits_min_cred { break; }
            }
        } else {
            println!("  Account not found yet... (attempt {}/30)", wait_for_credits_i + 1);
        }
        tokio::time::sleep(std::time::Duration::from_secs(2)).await;
    }
    println!("Credits reached");

    // =========================================================
    // CreateIdentity (Action: CreateIdentity)
    // =========================================================
    let create_identity_url = format!("acc://{}.acme", adi_name);
    let mut create_identity_signer = SmartSigner::new(&client, generate_keys_signer.clone(), &generate_keys_lid);
    let create_identity_result = create_identity_signer.sign_submit_and_wait(
        &generate_keys_lta,
        &TxBody::create_identity(&create_identity_url, &format!("{}/book", create_identity_url), &generate_keys_pub_hash),
        Some("Create ADI"),
        30,
    ).await;
    if create_identity_result.success {
        println!("CreateIdentity SUCCESS - TxID: {:?}", create_identity_result.txid);
        if let Some(ref txid) = create_identity_result.txid {
            tx_ids.push(("CreateIdentity", txid.clone()));
        }
    } else {
        println!("CreateIdentity FAILED: {:?}", create_identity_result.error);
    }

    // =========================================================
    // AddCredits (Action: AddCredits)
    // =========================================================
    let add_adi_credits_oracle: Value = client.v3_client.call_v3("network-status", json!({})).await
        .unwrap_or_else(|_| json!({}));
    let add_adi_credits_price = add_adi_credits_oracle.get("oracle")
        .and_then(|o| o.get("price"))
        .and_then(|p| p.as_u64())
        .unwrap_or(50000000);
    let mut add_adi_credits_signer = SmartSigner::new(&client, generate_keys_signer.clone(), &generate_keys_lid);
    let add_adi_credits_result = add_adi_credits_signer.sign_submit_and_wait(
        &generate_keys_lta,
        &TxBody::add_credits(&format!("{}/book/1", create_identity_url), "500000000", add_adi_credits_price),
        Some("Add credits"),
        30,
    ).await;
    if add_adi_credits_result.success {
        println!("AddCredits SUCCESS - TxID: {:?}", add_adi_credits_result.txid);
        if let Some(ref txid) = add_adi_credits_result.txid {
            tx_ids.push(("AddCredits", txid.clone()));
        }
    } else {
        println!("AddCredits FAILED: {:?}", add_adi_credits_result.error);
    }

    // =========================================================
    // WaitForCredits (Action: WaitForCredits)
    // =========================================================
    println!("Waiting for credits...");
    let wait_for_adi_credits_scope = format!("{}/book/1", create_identity_url).to_string();
    let wait_for_adi_credits_min_cred: u64 = 1000;
    for wait_for_adi_credits_i in 0..30u32 {
        let wait_for_adi_credits_params = json!({ "scope": wait_for_adi_credits_scope, "query": { "queryType": "default" } });
        if let Ok(wait_for_adi_credits_acct) = client.v3_client.call_v3::<Value>("query", wait_for_adi_credits_params).await {
            if let Some(cred) = wait_for_adi_credits_acct.get("account").and_then(|a| a.get("creditBalance")).and_then(|c| c.as_u64()) {
                if cred >= wait_for_adi_credits_min_cred { break; }
            }
        } else {
            println!("  Account not found yet... (attempt {}/30)", wait_for_adi_credits_i + 1);
        }
        tokio::time::sleep(std::time::Duration::from_secs(2)).await;
    }
    println!("Credits reached");

    // =========================================================
    // CreateTokenAccount (Action: CreateTokenAccount)
    // =========================================================
    let create_sender_account_url = format!("acc://{}.acme/htlc-sender", adi_name);
    let mut create_sender_account_signer = SmartSigner::new(&client, generate_keys_signer.clone(), &format!("{}/book/1", create_identity_url));
    let create_sender_account_result = create_sender_account_signer.sign_submit_and_wait(
        &create_identity_url,
        &TxBody::create_token_account(&create_sender_account_url, "acc://ACME"),
        Some("Create token account"),
        30,
    ).await;
    if create_sender_account_result.success {
        println!("CreateTokenAccount SUCCESS - TxID: {:?}", create_sender_account_result.txid);
        if let Some(ref txid) = create_sender_account_result.txid {
            tx_ids.push(("CreateTokenAccount", txid.clone()));
        }
    } else {
        println!("CreateTokenAccount FAILED: {:?}", create_sender_account_result.error);
    }

    // =========================================================
    // CreateTokenAccount (Action: CreateTokenAccount)
    // =========================================================
    let create_receiver_account_url = format!("acc://{}.acme/htlc-receiver", adi_name);
    let mut create_receiver_account_signer = SmartSigner::new(&client, generate_keys_signer.clone(), &format!("{}/book/1", create_identity_url));
    let create_receiver_account_result = create_receiver_account_signer.sign_submit_and_wait(
        &create_identity_url,
        &TxBody::create_token_account(&create_receiver_account_url, "acc://ACME"),
        Some("Create token account"),
        30,
    ).await;
    if create_receiver_account_result.success {
        println!("CreateTokenAccount SUCCESS - TxID: {:?}", create_receiver_account_result.txid);
        if let Some(ref txid) = create_receiver_account_result.txid {
            tx_ids.push(("CreateTokenAccount", txid.clone()));
        }
    } else {
        println!("CreateTokenAccount FAILED: {:?}", create_receiver_account_result.error);
    }

    // =========================================================
    // SendTokens (Action: SendTokens)
    // =========================================================
    let mut fund_sender_signer = SmartSigner::new(&client, generate_keys_signer.clone(), &generate_keys_lid);
    let fund_sender_result = fund_sender_signer.sign_submit_and_wait(
        &generate_keys_lta,
        &TxBody::send_tokens_single(&create_sender_account_url, "500000000"),
        Some("Send tokens"),
        30,
    ).await;
    if fund_sender_result.success {
        println!("SendTokens SUCCESS - TxID: {:?}", fund_sender_result.txid);
        if let Some(ref txid) = fund_sender_result.txid {
            tx_ids.push(("SendTokens", txid.clone()));
        }
    } else {
        println!("SendTokens FAILED: {:?}", fund_sender_result.error);
    }

    // =========================================================
    // WaitForBalance (Action: WaitForBalance)
    // =========================================================
    println!("Waiting for balance...");
    let wait_for_sender_balance_scope = create_sender_account_url.to_string();
    let wait_for_sender_balance_min_bal: u64 = "1.00000000".replace('.', "").parse().unwrap_or(10000000);
    for wait_for_sender_balance_i in 0..30u32 {
        let wait_for_sender_balance_params = json!({ "scope": wait_for_sender_balance_scope, "query": { "queryType": "default" } });
        if let Ok(wait_for_sender_balance_acct) = client.v3_client.call_v3::<Value>("query", wait_for_sender_balance_params).await {
            if let Some(bal) = wait_for_sender_balance_acct.get("account").and_then(|a| a.get("balance")).and_then(|b| b.as_str()) {
                if bal.parse::<u64>().unwrap_or(0) >= wait_for_sender_balance_min_bal { break; }
            }
        } else {
            println!("  Account not found yet... (attempt {}/30)", wait_for_sender_balance_i + 1);
        }
        tokio::time::sleep(std::time::Duration::from_secs(2)).await;
    }
    println!("Balance reached");

    // =========================================================
    // GenerateHashLock (Action: GenerateHashLock)
    // =========================================================
    // The lock is a hash of a secret preimage. The preimage stays with you until the
    // release transaction reveals it on-chain.
    let mut create_hash_lock_preimage_bytes = vec![0u8; 32];
    getrandom::getrandom(&mut create_hash_lock_preimage_bytes).unwrap_or_else(|e| fail(&format!("no random bytes: {}", e)));
    let create_hash_lock_preimage = hex::encode(&create_hash_lock_preimage_bytes);
    let create_hash_lock_hash_bytes = Sha256::digest(&create_hash_lock_preimage_bytes).to_vec();
    let create_hash_lock_hash = hex::encode(&create_hash_lock_hash_bytes);
    let create_hash_lock_hash_algorithm = "sha256";
    // Whole Unix seconds: the node needs 10 minutes to 30 days of headroom
    let create_hash_lock_now = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_secs() as i64;
    let create_hash_lock_expiration: i64 = create_hash_lock_now + 30 * 60;
    let create_hash_lock_lock = TxBody::hash_lock(HashAlgorithm::Sha256, create_hash_lock_hash_bytes.clone(), create_hash_lock_expiration);
    create_hash_lock_lock.validate_for_submit(create_hash_lock_now).unwrap_or_else(|e| fail(&format!("invalid hash lock: {}", e)));
    let create_hash_lock_expiration_iso = create_hash_lock_lock.expiration.clone().unwrap_or_default();
    println!("Hash lock ready:");
    println!("  algorithm: {}", create_hash_lock_hash_algorithm);
    println!("  hash:      {}", create_hash_lock_hash);
    println!("  expires:   {}", create_hash_lock_expiration_iso);
    println!("  PREIMAGE:  {}", create_hash_lock_preimage);

    // =========================================================
    // SendTokens (Action: SendTokens, hash-locked)
    // =========================================================
    // Hash-locked send: the sender is debited now and the recipient is credited only
    // when a ReleaseLockedOperation reveals the preimage. The lock rides in the
    // transaction header, so the \`_with_options\` variant is required.
    let mut locked_send_signer = SmartSigner::new(&client, generate_keys_signer.clone(), &format!("{}/book/1", create_identity_url));
    let locked_send_options = HeaderOptions { hash_lock: Some(create_hash_lock_lock.clone()), ..Default::default() };
    let locked_send_result = locked_send_signer.sign_submit_and_wait_with_options(
        &create_sender_account_url,
        &TxBody::send_tokens_single(&create_receiver_account_url, &lock_amount),
        &locked_send_options,
        30,
    ).await;
    let locked_send_txid = confirm(&client, "SendTokens (hash-locked)", &locked_send_result).await;
    println!("SendTokens LOCKED - TxID: {}", locked_send_txid);
    tx_ids.push(("SendTokens (hash-locked)", locked_send_txid.clone()));


    // =========================================================
    // WaitForLockedDeposit (Action: WaitForLockedDeposit)
    // =========================================================
    // A release targets the locked DEPOSIT, not the send. The deposit is one of the
    // send's produced transactions. A query error just means it is not ready yet, and
    // \`produced.total\` can over-count, so scan the records themselves.
    let wait_for_locked_deposit_send_txid: String = locked_send_txid.clone();
    let mut wait_for_locked_deposit_found: Option<String> = None;
    println!("Waiting for the locked deposit produced by {}...", wait_for_locked_deposit_send_txid);
    for wait_for_locked_deposit_attempt in 1..=60u32 {
        if let Ok(send) = query(&client, &wait_for_locked_deposit_send_txid).await {
            for rec in send["produced"]["records"].as_array().into_iter().flatten() {
                let Some(id) = rec["value"].as_str() else { continue };
                // NotFound while the produced transaction is still in flight is not an error.
                let Ok(dep) = query(&client, id).await else { continue };
                if dep["message"]["transaction"]["body"]["type"] == "syntheticLockedDeposit"
                    && dep["status"] == "delivered"
                {
                    wait_for_locked_deposit_found = Some(id.to_string());
                    break;
                }
            }
        }
        if wait_for_locked_deposit_found.is_some() {
            break;
        }
        println!("  Waiting for locked deposit... (attempt {}/60)", wait_for_locked_deposit_attempt);
        tokio::time::sleep(std::time::Duration::from_millis(2000)).await;
    }
    let wait_for_locked_deposit_locked_txid: String = match wait_for_locked_deposit_found {
        Some(id) => id,
        None => fail("the locked deposit was not delivered in time"),
    };
    println!("Locked deposit: {}", wait_for_locked_deposit_locked_txid);
    tx_ids.push(("LockedDeposit", wait_for_locked_deposit_locked_txid.clone()));

    // =========================================================
    // ReleaseLockedOperation (Action: ReleaseLockedOperation)
    // =========================================================
    // The RECIPIENT account releases the deposit and pays the small fee, so the signer
    // needs credits. A wrong preimage or an expired lock is accepted at submit and only
    // fails when the transaction executes; confirm() checks the final status.
    let mut release_locked_signer = SmartSigner::new(&client, generate_keys_signer.clone(), &format!("{}/book/1", create_identity_url));
    let release_locked_preimage_bytes: Vec<u8> = hex::decode(&create_hash_lock_preimage).unwrap_or_else(|_| fail("invalid preimage hex"));
    let release_locked_result = release_locked_signer.sign_submit_and_wait(
        &create_receiver_account_url,
        &TxBody::release_locked_operation(&wait_for_locked_deposit_locked_txid, &release_locked_preimage_bytes),
        Some("Release locked"),
        30,
    ).await;
    let release_locked_txid = confirm(&client, "ReleaseLockedOperation", &release_locked_result).await;
    println!("ReleaseLockedOperation SUCCESS - TxID: {}", release_locked_txid);
    tx_ids.push(("ReleaseLockedOperation", release_locked_txid.clone()));

    // =========================================================
    // WaitForBalance (Action: WaitForBalance)
    // =========================================================
    println!("Waiting for balance...");
    let wait_for_receiver_balance_scope = create_receiver_account_url.to_string();
    let wait_for_receiver_balance_min_bal: u64 = "1.00000000".replace('.', "").parse().unwrap_or(10000000);
    for wait_for_receiver_balance_i in 0..30u32 {
        let wait_for_receiver_balance_params = json!({ "scope": wait_for_receiver_balance_scope, "query": { "queryType": "default" } });
        if let Ok(wait_for_receiver_balance_acct) = client.v3_client.call_v3::<Value>("query", wait_for_receiver_balance_params).await {
            if let Some(bal) = wait_for_receiver_balance_acct.get("account").and_then(|a| a.get("balance")).and_then(|b| b.as_str()) {
                if bal.parse::<u64>().unwrap_or(0) >= wait_for_receiver_balance_min_bal { break; }
            }
        } else {
            println!("  Account not found yet... (attempt {}/30)", wait_for_receiver_balance_i + 1);
        }
        tokio::time::sleep(std::time::Duration::from_secs(2)).await;
    }
    println!("Balance reached");

    // =========================================================
    // Transaction Summary
    // =========================================================
    println!("\\n========== Transaction Summary ==========");
    for (label, txid) in &tx_ids {
        println!("  {}: {}", label, txid);
    }
    println!("Flow completed successfully!");
    Ok(())
}
"
`;

