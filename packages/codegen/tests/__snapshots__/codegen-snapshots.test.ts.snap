"#!/usr/bin/env python3
"""
Custom Token Issuance
=====================

Generated by Accumulate Studio
Network: devnet
"""

import time

from accumulate_client import Accumulate, NetworkStatusOptions
from accumulate_client.convenience import TxBody, SmartSigner

# Network endpoints
NETWORK_ENDPOINT = "https://devnet.accumulatenetwork.io"
# For local DevNet testing, uncomment:
# NETWORK_ENDPOINT = "http://127.0.0.1:26660"


def main():
    """
    Custom Token Issuance
    Advanced flow for creating your own custom token on Accumulate. Creates a token issuer account, issues tokens, and sends them to a recipient. Demonstrates the full token lifecycle.

    Generated by Accumulate Studio
    """

    # Connect to the network
    client = Accumulate(NETWORK_ENDPOINT)
    tx_ids = []

    # Flow variables (customize these for your use case)
    adi_url = ""  # 
    token_symbol = "TKN"  # 
    token_precision = ""  # 
    supply_limit = ""  # 
    initial_issue_amount = "100000000000"  # 
    recipient_url = ""  # 

    try:


        # =========================================================
        # CreateToken (Action: CreateToken)
        # =========================================================
        create_token_url = f"{adi_url}/{token_symbol}"
        create_token_signer = SmartSigner(client.v3, create_token_kp, create_token_lid)
        create_token_result = create_token_signer.sign_submit_and_wait(
            principal=adi_url,
            body=TxBody.create_token(
                url=create_token_url,
                symbol=token_symbol,
                precision=token_precision,
            ),
            max_attempts=30,
        )
        if create_token_result.success:
            print(f"CreateToken SUCCESS - TxID: {create_token_result.txid}")
            tx_ids.append(("CreateToken", create_token_result.txid))
        else:
            print(f"CreateToken FAILED: {create_token_result.error}")

        # =========================================================
        # IssueTokens (Action: IssueTokens)
        # =========================================================
        issue_tokens_signer = SmartSigner(client.v3, issue_tokens_kp, issue_tokens_lid)
        issue_tokens_result = issue_tokens_signer.sign_submit_and_wait(
            principal=f"{adi_url}/{token_symbol}",
            body=TxBody.issue_tokens_single(
                to_url=recipient_url,
                amount=initial_issue_amount,
            ),
            max_attempts=30,
        )
        if issue_tokens_result.success:
            print(f"IssueTokens SUCCESS - TxID: {issue_tokens_result.txid}")
            tx_ids.append(("IssueTokens", issue_tokens_result.txid))
        else:
            print(f"IssueTokens FAILED: {issue_tokens_result.error}")

        # =========================================================
        # QueryAccount (Action: QueryAccount)
        # =========================================================
        query_token_result = client.v3.query(f"{adi_url}/{token_symbol}")
        print(f"Account state: {query_token_result}")

        # =========================================================
        # SendTokens (Action: SendTokens)
        # =========================================================
        send_tokens_signer = SmartSigner(client.v3, send_tokens_kp, send_tokens_lid)
        send_tokens_result = send_tokens_signer.sign_submit_and_wait(
            principal=recipient_url,
            body=TxBody.send_tokens_single(
                to_url=recipient_url,
                amount="100.00000000",
            ),
            max_attempts=30,
        )
        if send_tokens_result.success:
            print(f"SendTokens SUCCESS - TxID: {send_tokens_result.txid}")
            tx_ids.append(("SendTokens", send_tokens_result.txid))
        else:
            print(f"SendTokens FAILED: {send_tokens_result.error}")

        # =========================================================
        # Summary
        # =========================================================
        print("\\n=== TRANSACTION IDs FOR VERIFICATION ===\\n")
        for tx_name, txid in tx_ids:
            print(f"  {tx_name}: {txid}")
        print(f"\\nTotal transactions: {len(tx_ids)}")
        print("Flow completed successfully!")

    finally:
        client.close()


if __name__ == "__main__":
    main()
