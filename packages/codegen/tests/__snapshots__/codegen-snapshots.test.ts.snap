"#!/usr/bin/env python3
"""
Hash Lock (HTLC) Payment
========================

Generated by Accumulate Studio
Network: devnet
"""

import time
import os
import sys
from datetime import datetime, timedelta, timezone

from accumulate_client import Accumulate, NetworkStatusOptions
from accumulate_client.convenience import TxBody, SmartSigner
from accumulate_client.tx.header import HashLockOptions  # not the top-level export, which is a different class
from accumulate_client.crypto.ed25519 import Ed25519KeyPair
import hashlib
import requests as _requests_lib

# Network endpoints
NETWORK_ENDPOINT = "https://devnet.accumulatenetwork.io"
# For local DevNet testing, uncomment:
# NETWORK_ENDPOINT = "http://127.0.0.1:26660"


def fund_account(client, account_url, faucet_requests=1):
    """Fund an account using the testnet faucet with retry logic."""
    v2_endpoint = client.v2.endpoint
    print(f"Requesting funds from faucet ({faucet_requests} times)...")
    for i in range(faucet_requests):
        try:
            response = _requests_lib.post(
                v2_endpoint,
                json={
                    "jsonrpc": "2.0",
                    "method": "faucet",
                    "params": {"url": account_url},
                    "id": i + 1,
                },
                timeout=30,
            )
            result = response.json()
            txid = result.get("result", {}).get("txid", "submitted")
            print(f"  Faucet {i+1}/{faucet_requests}: {str(txid)[:40]}...")
            time.sleep(2)
        except Exception as e:
            print(f"  Faucet {i+1}/{faucet_requests} failed: {e}")


def poll_for_balance(client, account_url, min_balance=1, max_attempts=30):
    """Poll until account balance meets minimum threshold."""
    for i in range(max_attempts):
        try:
            result = client.v3.query(account_url)
            balance = result.get("account", {}).get("balance")
            if balance is not None:
                balance_int = int(balance) if isinstance(balance, (int, str)) else 0
                if balance_int > 0 and balance_int >= min_balance:
                    return balance_int
            print(f"  Waiting for balance... (attempt {i+1}/{max_attempts})")
        except Exception:
            pass
        time.sleep(2)
    return 0


def poll_for_credits(client, account_url, min_credits=1, max_attempts=30):
    """Poll until account credit balance meets minimum threshold."""
    for i in range(max_attempts):
        try:
            result = client.v3.query(account_url)
            credits = result.get("account", {}).get("creditBalance", 0)
            if int(credits) > 0 and int(credits) >= min_credits:
                return int(credits)
            print(f"  Waiting for credits... (attempt {i+1}/{max_attempts})")
        except Exception:
            pass
        time.sleep(2)
    return 0


def main():
    """
    Hash Lock (HTLC) Payment
    Locks tokens to a SHA-256 hash, finds the locked deposit, releases it by revealing the secret preimage and proves the receiver was credited. One ADI owns both accounts here; in a real swap the receiver is another party.

    Generated by Accumulate Studio
    """

    # Connect to the network
    client = Accumulate(NETWORK_ENDPOINT)
    tx_ids = []

    # Flow variables (customize these for your use case)
    adi_name = f"adi-{int(time.time())}-{os.urandom(3).hex()}"  # 
    lock_amount = "100000000"  # 

    try:


        # =========================================================
        # GenerateKeys (Action: GenerateKeys)
        # =========================================================
        generate_keys_kp = Ed25519KeyPair.generate()
        generate_keys_lid = generate_keys_kp.derive_lite_identity_url()
        generate_keys_lta = generate_keys_kp.derive_lite_token_account_url("ACME")
        generate_keys_pub_hash = hashlib.sha256(generate_keys_kp.public_key_bytes()).hexdigest()
        print(f"Generated keypair:")
        print(f"  Lite Identity: {generate_keys_lid}")
        print(f"  Lite Token Account: {generate_keys_lta}")

        # =========================================================
        # Faucet (Action: Faucet)
        # =========================================================
        fund_account(client, str(generate_keys_lta), faucet_requests=3)
        print("Faucet request completed")

        # =========================================================
        # WaitForBalance (Action: WaitForBalance)
        # =========================================================
        print("Waiting for balance >= 15.00000000...")
        _balance = poll_for_balance(client, str(generate_keys_lta), min_balance=15.00000000)
        if _balance == 0:
            print("ERROR: Balance did not reach minimum. Stopping.")
            return
        print(f"Balance confirmed: {_balance}")

        # =========================================================
        # AddCredits (Action: AddCredits)
        # =========================================================
        add_credits_oracle = client.v3.network_status(
            NetworkStatusOptions(partition="directory")
        ).get("oracle", {}).get("price", 500000)
        print(f"Oracle price: {add_credits_oracle}")
        add_credits_signer = SmartSigner(client.v3, generate_keys_kp, generate_keys_lid)
        add_credits_result = add_credits_signer.sign_submit_and_wait(
            principal=str(generate_keys_lta),
            body=TxBody.add_credits(
                recipient=str(generate_keys_lid),
                amount="500000000",
                oracle=add_credits_oracle,
            ),
            max_attempts=30,
        )
        if add_credits_result.success:
            print(f"AddCredits SUCCESS - TxID: {add_credits_result.txid}")
            tx_ids.append(("AddCredits", add_credits_result.txid))
        else:
            print(f"AddCredits FAILED: {add_credits_result.error}")

        # =========================================================
        # WaitForCredits (Action: WaitForCredits)
        # =========================================================
        print("Waiting for credits >= 1000...")
        _credits = poll_for_credits(client, str(generate_keys_lid), min_credits=1000)
        if _credits == 0:
            print("ERROR: Credits did not reach minimum. Stopping.")
            return
        print(f"Credits confirmed: {_credits}")

        # =========================================================
        # CreateIdentity (Action: CreateIdentity)
        # =========================================================
        create_identity_url = f"acc://{adi_name}.acme"
        create_identity_signer = SmartSigner(client.v3, generate_keys_kp, generate_keys_lid)
        create_identity_result = create_identity_signer.sign_submit_and_wait(
            principal=str(generate_keys_lta),
            body=TxBody.create_identity(
                url=create_identity_url,
                key_book_url=f"{create_identity_url}/book",
                public_key_hash=generate_keys_pub_hash,
            ),
            max_attempts=30,
        )
        if create_identity_result.success:
            print(f"CreateIdentity SUCCESS - TxID: {create_identity_result.txid}")
            tx_ids.append(("CreateIdentity", create_identity_result.txid))
        else:
            print(f"CreateIdentity FAILED: {create_identity_result.error}")

        # =========================================================
        # AddCredits (Action: AddCredits)
        # =========================================================
        add_adi_credits_oracle = client.v3.network_status(
            NetworkStatusOptions(partition="directory")
        ).get("oracle", {}).get("price", 500000)
        print(f"Oracle price: {add_adi_credits_oracle}")
        add_adi_credits_signer = SmartSigner(client.v3, generate_keys_kp, generate_keys_lid)
        add_adi_credits_result = add_adi_credits_signer.sign_submit_and_wait(
            principal=str(generate_keys_lta),
            body=TxBody.add_credits(
                recipient=f"{str(create_identity_url)}/book/1",
                amount="500000000",
                oracle=add_adi_credits_oracle,
            ),
            max_attempts=30,
        )
        if add_adi_credits_result.success:
            print(f"AddCredits SUCCESS - TxID: {add_adi_credits_result.txid}")
            tx_ids.append(("AddCredits", add_adi_credits_result.txid))
        else:
            print(f"AddCredits FAILED: {add_adi_credits_result.error}")

        # =========================================================
        # WaitForCredits (Action: WaitForCredits)
        # =========================================================
        print("Waiting for credits >= 1000...")
        _credits = poll_for_credits(client, f"{str(create_identity_url)}/book/1", min_credits=1000)
        if _credits == 0:
            print("ERROR: Credits did not reach minimum. Stopping.")
            return
        print(f"Credits confirmed: {_credits}")

        # =========================================================
        # CreateTokenAccount (Action: CreateTokenAccount)
        # =========================================================
        create_sender_account_url = f"acc://{adi_name}.acme/htlc-sender"
        create_sender_account_signer = SmartSigner(client.v3, generate_keys_kp, f"{str(create_identity_url)}/book/1")
        create_sender_account_result = create_sender_account_signer.sign_submit_and_wait(
            principal=str(create_identity_url),
            body=TxBody.create_token_account(
                url=create_sender_account_url,
                token_url="acc://ACME",
            ),
            max_attempts=30,
        )
        if create_sender_account_result.success:
            print(f"CreateTokenAccount SUCCESS - TxID: {create_sender_account_result.txid}")
            tx_ids.append(("CreateTokenAccount", create_sender_account_result.txid))
        else:
            print(f"CreateTokenAccount FAILED: {create_sender_account_result.error}")

        # =========================================================
        # CreateTokenAccount (Action: CreateTokenAccount)
        # =========================================================
        create_receiver_account_url = f"acc://{adi_name}.acme/htlc-receiver"
        create_receiver_account_signer = SmartSigner(client.v3, generate_keys_kp, f"{str(create_identity_url)}/book/1")
        create_receiver_account_result = create_receiver_account_signer.sign_submit_and_wait(
            principal=str(create_identity_url),
            body=TxBody.create_token_account(
                url=create_receiver_account_url,
                token_url="acc://ACME",
            ),
            max_attempts=30,
        )
        if create_receiver_account_result.success:
            print(f"CreateTokenAccount SUCCESS - TxID: {create_receiver_account_result.txid}")
            tx_ids.append(("CreateTokenAccount", create_receiver_account_result.txid))
        else:
            print(f"CreateTokenAccount FAILED: {create_receiver_account_result.error}")

        # =========================================================
        # SendTokens (Action: SendTokens)
        # =========================================================
        fund_sender_signer = SmartSigner(client.v3, generate_keys_kp, str(generate_keys_lid))
        fund_sender_result = fund_sender_signer.sign_submit_and_wait(
            principal=str(generate_keys_lta),
            body=TxBody.send_tokens_single(
                to_url=str(create_sender_account_url),
                amount="500000000",
            ),
            max_attempts=30,
        )
        if fund_sender_result.success:
            print(f"SendTokens SUCCESS - TxID: {fund_sender_result.txid}")
            tx_ids.append(("SendTokens", fund_sender_result.txid))
        else:
            print(f"SendTokens FAILED: {fund_sender_result.error}")

        # =========================================================
        # WaitForBalance (Action: WaitForBalance)
        # =========================================================
        print("Waiting for balance >= 1.00000000...")
        _balance = poll_for_balance(client, str(create_sender_account_url), min_balance=1.00000000)
        if _balance == 0:
            print("ERROR: Balance did not reach minimum. Stopping.")
            return
        print(f"Balance confirmed: {_balance}")

        # =========================================================
        # GenerateHashLock (Action: GenerateHashLock)
        # =========================================================
        # The lock is a hash of a secret preimage. The preimage stays with you until the
        # release transaction reveals it on-chain.
        create_hash_lock_preimage_bytes = os.urandom(32)
        create_hash_lock_preimage = create_hash_lock_preimage_bytes.hex()
        create_hash_lock_hash_bytes = hashlib.sha256(create_hash_lock_preimage_bytes).digest()
        create_hash_lock_hash = create_hash_lock_hash_bytes.hex()
        create_hash_lock_hash_algorithm = "sha256"
        # Whole seconds in UTC: the node needs 10 minutes to 30 days of headroom and rejects fractions
        create_hash_lock_expiration_dt = datetime.now(timezone.utc).replace(microsecond=0) + timedelta(minutes=30)
        create_hash_lock_expiration = int(create_hash_lock_expiration_dt.timestamp())
        create_hash_lock_expiration_iso = create_hash_lock_expiration_dt.isoformat()
        create_hash_lock_lock = HashLockOptions(
            hashAlgorithm=create_hash_lock_hash_algorithm,
            hash=create_hash_lock_hash_bytes,
            expiration=create_hash_lock_expiration_dt,
        )
        create_hash_lock_lock.validate_for_submit()
        print("Hash lock ready:")
        print(f"  algorithm: {create_hash_lock_hash_algorithm}")
        print(f"  hash:      {create_hash_lock_hash}")
        print(f"  expires:   {create_hash_lock_expiration_iso}")
        print(f"  PREIMAGE:  {create_hash_lock_preimage}")

        # =========================================================
        # SendTokens (Action: SendTokens, hash-locked)
        # =========================================================
        # Hash-locked send: the sender is debited now and the recipient is credited only
        # when a ReleaseLockedOperation reveals the preimage.
        locked_send_signer = SmartSigner(client.v3, generate_keys_kp, f"{str(create_identity_url)}/book/1")
        locked_send_result = locked_send_signer.sign_submit_and_wait(
            principal=str(create_sender_account_url),
            body=TxBody.send_tokens_single(
                to_url=str(create_receiver_account_url),
                amount=lock_amount,
            ),
            hash_lock=create_hash_lock_lock,
            max_attempts=45,
        )
        if not locked_send_result.success:
            print(f"SendTokens (hash-locked) FAILED: {locked_send_result.error}")
            sys.exit(1)
        locked_send_txid = locked_send_result.txid
        print(f"SendTokens LOCKED - TxID: {locked_send_txid}")
        tx_ids.append(("SendTokens (hash-locked)", locked_send_txid))


        # =========================================================
        # WaitForLockedDeposit (Action: WaitForLockedDeposit)
        # =========================================================
        # A release targets the locked DEPOSIT, not the send. The deposit is one of the
        # send's produced transactions. A query error just means it is not ready yet, and
        # \`produced.total\` can over-count, so scan the records themselves.
        wait_for_locked_deposit_send_txid = locked_send_txid
        wait_for_locked_deposit_locked_txid = None
        print(f"Waiting for the locked deposit produced by {wait_for_locked_deposit_send_txid}...")
        for _attempt in range(60):
            try:
                _records = (client.v3.query(wait_for_locked_deposit_send_txid).get("produced") or {}).get("records") or []
            except Exception:
                _records = []
            for _rec in _records:
                _produced_id = _rec.get("value")
                if not _produced_id:
                    continue
                try:
                    _q = client.v3.query(_produced_id)
                except Exception:
                    continue  # not found yet
                _body = ((_q.get("message") or {}).get("transaction") or {}).get("body") or {}
                if _body.get("type") == "syntheticLockedDeposit" and _q.get("status") == "delivered":
                    wait_for_locked_deposit_locked_txid = _produced_id
                    break
            if wait_for_locked_deposit_locked_txid:
                break
            print(f"  Waiting for locked deposit... (attempt {_attempt + 1}/60)")
            time.sleep(2)
        if not wait_for_locked_deposit_locked_txid:
            print("ERROR: the locked deposit was not delivered in time. Stopping.")
            sys.exit(1)
        print(f"Locked deposit: {wait_for_locked_deposit_locked_txid}")
        tx_ids.append(("LockedDeposit", wait_for_locked_deposit_locked_txid))

        # =========================================================
        # ReleaseLockedOperation (Action: ReleaseLockedOperation)
        # =========================================================
        # The RECIPIENT account releases the deposit and pays the small fee, so the signer
        # needs credits. A wrong preimage or an expired lock is accepted at submit and only
        # fails when the transaction executes; sign_submit_and_wait reports that failure.
        release_locked_preimage_bytes = bytes.fromhex(create_hash_lock_preimage)
        release_locked_signer = SmartSigner(client.v3, generate_keys_kp, f"{str(create_identity_url)}/book/1")
        release_locked_result = release_locked_signer.sign_submit_and_wait(
            principal=str(create_receiver_account_url),
            body=TxBody.release_locked_operation(wait_for_locked_deposit_locked_txid, release_locked_preimage_bytes),
            max_attempts=45,
        )
        if release_locked_result.txid:
            tx_ids.append(("ReleaseLockedOperation", release_locked_result.txid))
        if not release_locked_result.success:
            print(f"ReleaseLockedOperation FAILED: {release_locked_result.error}")
            sys.exit(1)
        print(f"ReleaseLockedOperation SUCCESS - TxID: {release_locked_result.txid}")

        # =========================================================
        # WaitForBalance (Action: WaitForBalance)
        # =========================================================
        print("Waiting for balance >= 1.00000000...")
        _balance = poll_for_balance(client, str(create_receiver_account_url), min_balance=1.00000000)
        if _balance == 0:
            print("ERROR: Balance did not reach minimum. Stopping.")
            return
        print(f"Balance confirmed: {_balance}")

        # =========================================================
        # Summary
        # =========================================================
        print("\\n=== TRANSACTION IDs FOR VERIFICATION ===\\n")
        for tx_name, txid in tx_ids:
            print(f"  {tx_name}: {txid}")
        print(f"\\nTotal transactions: {len(tx_ids)}")
        print("Flow completed successfully!")

    finally:
        client.close()


if __name__ == "__main__":
    main()
"
`;

