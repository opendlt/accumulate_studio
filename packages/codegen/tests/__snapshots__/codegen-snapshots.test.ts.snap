exports[`Codegen Snapshots > dart SDK > hash-lock generates expected dart code 1`] = `
"/// Hash Lock (HTLC) Payment
/// Generated by Accumulate Studio
/// Network: devnet

import 'dart:async';
import 'dart:convert';
import 'dart:io';
import 'dart:math';
import 'dart:typed_data';
import 'package:crypto/crypto.dart';
import 'package:opendlt_accumulate/opendlt_accumulate.dart';

const String defaultV2 = 'https://kermit.accumulatenetwork.io/v2';
const String defaultV3 = 'https://kermit.accumulatenetwork.io/v3';

String toHexString(List<int> bytes) {
  return bytes.map((b) => b.toRadixString(16).padLeft(2, '0')).join();
}

/// Stop with a non-zero exit code. A failed HTLC step must never look like success.
Never fail(String message) {
  print('FAILED: $message');
  exit(1);
}

Uint8List randomBytes(int n) {
  final rng = Random.secure();
  return Uint8List.fromList(List<int>.generate(n, (_) => rng.nextInt(256)));
}

/// Strict hex decoding (even length, hex digits only).
Uint8List fromHex(String hex) {
  if (hex.isEmpty || hex.length.isOdd || !RegExp(r'^[0-9a-fA-F]+$').hasMatch(hex)) {
    fail('invalid hex value');
  }
  return Uint8List.fromList(
    List<int>.generate(hex.length ~/ 2, (i) => int.parse(hex.substring(i * 2, i * 2 + 2), radix: 16)),
  );
}

/// v3 \`query\` of an account or transaction id.
Future<Map<String, dynamic>> queryScope(AccumulateV3 v3, String scope) async {
  final r = await v3.rawCall('query', {
    'scope': scope,
    'query': {'queryType': 'default'},
  });
  return Map<String, dynamic>.from(r as Map);
}

/// Confirm a SmartSigner result from the node's own v3 status and return the
/// TRANSACTION id. The SDK cannot be trusted on its own here:
///  * signSubmitAndWait returns the id of the SIGNATURE message, not of the
///    transaction, so the id is resolved through \`message.txID\`;
///  * its wait treats any status other than "delivered" as pending, so a
///    transaction that FAILS at execute (a wrong preimage, an expired lock) is
///    reported as a success or a timeout and the node's error text is lost.
Future<String> confirmDelivered(AccumulateV3 v3, String label, TransactionResult r) async {
  if (r.txid == null) fail('$label failed: \${r.error}');
  var txid = r.txid!;
  try {
    final q = await queryScope(v3, txid);
    final msg = q['message'];
    if (msg is Map && msg['type'] == 'signature' && msg['txID'] != null) {
      txid = msg['txID'].toString();
    }
  } catch (_) {}
  var last = r.error ?? 'no status';
  for (var i = 0; i < 30; i++) {
    Map<String, dynamic>? q;
    try {
      q = await queryScope(v3, txid);
    } catch (e) {
      last = '$e';
    }
    if (q != null) {
      final status = q['status'];
      final err = q['error'];
      final statusNo = q['statusNo'];
      if (err != null || (statusNo is int && statusNo >= 400)) {
        final message = err is Map && err['message'] != null ? err['message'] : status;
        fail('$label failed: $message ($status, code $statusNo) txid=$txid');
      }
      if (status == 'delivered') return txid;
      last = '$status';
    }
    await Future.delayed(const Duration(seconds: 2));
  }
  fail('$label: not delivered ($last; sdk: \${r.error}) txid=$txid');
}

Future<void> main() async {
  final v2 = Platform.environment['ACCUMULATE_V2_URL'] ?? defaultV2;
  final v3 = Platform.environment['ACCUMULATE_V3_URL'] ?? defaultV3;
  final client = Accumulate.custom(v2Endpoint: v2, v3Endpoint: v3);
  final txIds = <MapEntry<String, String>>[];
  try {
    // Flow variables (customize these for your use case)
    final adi_name = 'adi-\${DateTime.now().millisecondsSinceEpoch ~/ 1000}-\${Random().nextInt(0x1000000).toRadixString(16).padLeft(6, '0')}';  // 
    final lock_amount = '100000000';  // 


    // =========================================================
    // GenerateKeys (GenerateKeys)
    // =========================================================
    final generateKeysKp = await Ed25519KeyPair.generate();
    final generateKeysKey = UnifiedKeyPair.fromEd25519(generateKeysKp);
    final generateKeysLid = await generateKeysKp.deriveLiteIdentityUrl();
    final generateKeysLta = await generateKeysKp.deriveLiteTokenAccountUrl();
    final generateKeysPubKey = await generateKeysKp.publicKeyBytes();
    final generateKeysPubHash = toHexString(sha256.convert(generateKeysPubKey).bytes);
    print('Generated keypair:');
    print('  Lite Identity: \${generateKeysLid}');
    print('  Lite Token Account: \${generateKeysLta}');
    print('  Public Key Hash: \${generateKeysPubHash}');


    // =========================================================
    // Faucet (Faucet)
    // =========================================================
    print('Requesting tokens from faucet...');
    for (var i = 0; i < 3; i++) {
      try {
        final resp = await client.v2.faucet({
          'type': 'acmeFaucet',
          'url': generateKeysLta.toString(),
        });
        print('  Faucet \${i + 1}/3: \${resp["txid"]}');
      } catch (e) {
        print('  Faucet \${i + 1}/3 failed: $e');
      }
      await Future.delayed(Duration(seconds: 2));
    }
    print('Faucet request completed');


    // =========================================================
    // WaitForBalance (WaitForBalance)
    // =========================================================
    print('Waiting for balance >= 15.00000000...');
    final waitForBalanceMinBal = BigInt.parse('15.00000000'.replaceAll('.', ''));
    for (var i = 0; i < 30; i++) {
      try {
        final result = await client.v3.rawCall('query', {
          'scope': generateKeysLta.toString(),
          'query': {'queryType': 'default'},
        });
        final balance = result['account']?['balance'];
        if (balance != null && BigInt.parse(balance.toString()) >= waitForBalanceMinBal) break;
      } catch (_) {}
      await Future.delayed(Duration(seconds: 2));
    }
    print('Balance reached');


    // =========================================================
    // AddCredits (Action: AddCredits)
    // =========================================================
    final addCreditsOracle = await client.v3.rawCall('network-status', {});
    final addCreditsOraclePrice = addCreditsOracle['oracle']['price'] as int;
    final addCreditsSigner = SmartSigner(
      client: client.v3,
      keypair: generateKeysKey,
      signerUrl: generateKeysLid.toString(),
    );
    final addCreditsResult = await addCreditsSigner.signSubmitAndWait(
      principal: generateKeysLta.toString(),
      body: TxBody.addCredits(
        recipient: generateKeysLid.toString(),
        amount: '500000000',
        oracle: addCreditsOraclePrice,
      ),
      memo: 'Add credits',
      maxAttempts: 30,
    );
    if (addCreditsResult.success) {
      print('AddCredits SUCCESS - TxID: \${addCreditsResult.txid}');
      if (addCreditsResult.txid != null) {
        txIds.add(MapEntry('AddCredits', addCreditsResult.txid!));
      }
    } else {
      print('AddCredits FAILED: \${addCreditsResult.error}');
    }


    // =========================================================
    // WaitForCredits (WaitForCredits)
    // =========================================================
    print('Waiting for credits >= 1000...');
    for (var i = 0; i < 30; i++) {
      try {
        final result = await client.v3.rawCall('query', {
          'scope': generateKeysLid.toString(),
          'query': {'queryType': 'default'},
        });
        final creditBalance = result['account']?['creditBalance'];
        if (creditBalance != null && (creditBalance as int) >= 1000) break;
      } catch (_) {}
      await Future.delayed(Duration(seconds: 2));
    }
    print('Credits reached');


    // =========================================================
    // CreateIdentity (Action: CreateIdentity)
    // =========================================================
    final createIdentityUrl = 'acc://\${adi_name}.acme';
    final createIdentitySigner = SmartSigner(
      client: client.v3,
      keypair: generateKeysKey,
      signerUrl: generateKeysLid.toString(),
    );
    final createIdentityResult = await createIdentitySigner.signSubmitAndWait(
      principal: generateKeysLta.toString(),
      body: TxBody.createIdentity(
        url: createIdentityUrl,
        keyBookUrl: '\${createIdentityUrl}/book',
        publicKeyHash: generateKeysPubHash,
      ),
      memo: 'Create ADI',
      maxAttempts: 30,
    );
    if (createIdentityResult.success) {
      print('CreateIdentity SUCCESS - TxID: \${createIdentityResult.txid}');
      if (createIdentityResult.txid != null) {
        txIds.add(MapEntry('CreateIdentity', createIdentityResult.txid!));
      }
    } else {
      print('CreateIdentity FAILED: \${createIdentityResult.error}');
    }


    // =========================================================
    // AddCredits (Action: AddCredits)
    // =========================================================
    final addAdiCreditsOracle = await client.v3.rawCall('network-status', {});
    final addAdiCreditsOraclePrice = addAdiCreditsOracle['oracle']['price'] as int;
    final addAdiCreditsSigner = SmartSigner(
      client: client.v3,
      keypair: generateKeysKey,
      signerUrl: generateKeysLid.toString(),
    );
    final addAdiCreditsResult = await addAdiCreditsSigner.signSubmitAndWait(
      principal: generateKeysLta.toString(),
      body: TxBody.addCredits(
        recipient: '\${createIdentityUrl}/book/1',
        amount: '500000000',
        oracle: addAdiCreditsOraclePrice,
      ),
      memo: 'Add credits',
      maxAttempts: 30,
    );
    if (addAdiCreditsResult.success) {
      print('AddCredits SUCCESS - TxID: \${addAdiCreditsResult.txid}');
      if (addAdiCreditsResult.txid != null) {
        txIds.add(MapEntry('AddCredits', addAdiCreditsResult.txid!));
      }
    } else {
      print('AddCredits FAILED: \${addAdiCreditsResult.error}');
    }


    // =========================================================
    // WaitForCredits (WaitForCredits)
    // =========================================================
    print('Waiting for credits >= 1000...');
    for (var i = 0; i < 30; i++) {
      try {
        final result = await client.v3.rawCall('query', {
          'scope': '\${createIdentityUrl}/book/1',
          'query': {'queryType': 'default'},
        });
        final creditBalance = result['account']?['creditBalance'];
        if (creditBalance != null && (creditBalance as int) >= 1000) break;
      } catch (_) {}
      await Future.delayed(Duration(seconds: 2));
    }
    print('Credits reached');


    // =========================================================
    // CreateTokenAccount (Action: CreateTokenAccount)
    // =========================================================
    final createSenderAccountUrl = 'acc://\${adi_name}.acme/htlc-sender';
    final createSenderAccountSigner = SmartSigner(
      client: client.v3,
      keypair: generateKeysKey,
      signerUrl: '\${createIdentityUrl}/book/1',
    );
    final createSenderAccountResult = await createSenderAccountSigner.signSubmitAndWait(
      principal: createIdentityUrl.toString(),
      body: TxBody.createTokenAccount(
        url: createSenderAccountUrl,
        tokenUrl: 'acc://ACME',
      ),
      memo: 'Create token account',
      maxAttempts: 30,
    );
    if (createSenderAccountResult.success) {
      print('CreateTokenAccount SUCCESS - TxID: \${createSenderAccountResult.txid}');
      if (createSenderAccountResult.txid != null) {
        txIds.add(MapEntry('CreateTokenAccount', createSenderAccountResult.txid!));
      }
    } else {
      print('CreateTokenAccount FAILED: \${createSenderAccountResult.error}');
    }


    // =========================================================
    // CreateTokenAccount (Action: CreateTokenAccount)
    // =========================================================
    final createReceiverAccountUrl = 'acc://\${adi_name}.acme/htlc-receiver';
    final createReceiverAccountSigner = SmartSigner(
      client: client.v3,
      keypair: generateKeysKey,
      signerUrl: '\${createIdentityUrl}/book/1',
    );
    final createReceiverAccountResult = await createReceiverAccountSigner.signSubmitAndWait(
      principal: createIdentityUrl.toString(),
      body: TxBody.createTokenAccount(
        url: createReceiverAccountUrl,
        tokenUrl: 'acc://ACME',
      ),
      memo: 'Create token account',
      maxAttempts: 30,
    );
    if (createReceiverAccountResult.success) {
      print('CreateTokenAccount SUCCESS - TxID: \${createReceiverAccountResult.txid}');
      if (createReceiverAccountResult.txid != null) {
        txIds.add(MapEntry('CreateTokenAccount', createReceiverAccountResult.txid!));
      }
    } else {
      print('CreateTokenAccount FAILED: \${createReceiverAccountResult.error}');
    }


    // =========================================================
    // SendTokens (Action: SendTokens)
    // =========================================================
    final fundSenderSigner = SmartSigner(
      client: client.v3,
      keypair: generateKeysKey,
      signerUrl: generateKeysLid.toString(),
    );
    final fundSenderResult = await fundSenderSigner.signSubmitAndWait(
      principal: generateKeysLta.toString(),
      body: TxBody.sendTokensSingle(
        toUrl: createSenderAccountUrl.toString(),
        amount: '500000000',
      ),
      memo: 'Send tokens',
      maxAttempts: 30,
    );
    if (fundSenderResult.success) {
      print('SendTokens SUCCESS - TxID: \${fundSenderResult.txid}');
      if (fundSenderResult.txid != null) {
        txIds.add(MapEntry('SendTokens', fundSenderResult.txid!));
      }
    } else {
      print('SendTokens FAILED: \${fundSenderResult.error}');
    }


    // =========================================================
    // WaitForBalance (WaitForBalance)
    // =========================================================
    print('Waiting for balance >= 1.00000000...');
    final waitForSenderBalanceMinBal = BigInt.parse('1.00000000'.replaceAll('.', ''));
    for (var i = 0; i < 30; i++) {
      try {
        final result = await client.v3.rawCall('query', {
          'scope': createSenderAccountUrl.toString(),
          'query': {'queryType': 'default'},
        });
        final balance = result['account']?['balance'];
        if (balance != null && BigInt.parse(balance.toString()) >= waitForSenderBalanceMinBal) break;
      } catch (_) {}
      await Future.delayed(Duration(seconds: 2));
    }
    print('Balance reached');


    // =========================================================
    // GenerateHashLock (GenerateHashLock)
    // =========================================================
    // The lock is a hash of a secret preimage. The preimage stays with you until the
    // release transaction reveals it on-chain.
    final createHashLockPreimageBytes = randomBytes(32);
    final createHashLockPreimage = toHexString(createHashLockPreimageBytes);
    final createHashLockHashBytes = Uint8List.fromList(sha256.convert(createHashLockPreimageBytes).bytes);
    final createHashLockHash = toHexString(createHashLockHashBytes);
    final createHashLockHashAlgorithm = 'sha256';
    // Whole seconds in UTC: the node needs 10 minutes to 30 days of headroom and rejects fractions
    final createHashLockNow = DateTime.now().toUtc();
    final createHashLockExpirationAt = DateTime.utc(createHashLockNow.year, createHashLockNow.month, createHashLockNow.day, createHashLockNow.hour, createHashLockNow.minute, createHashLockNow.second)
        .add(const Duration(minutes: 30));
    final createHashLockExpiration = createHashLockExpirationAt.millisecondsSinceEpoch ~/ 1000;
    final createHashLockExpirationIso = createHashLockExpirationAt.toIso8601String().replaceAll('.000Z', 'Z');
    final createHashLockLock = HashLockOptions(
      hashAlgorithm: HashAlgorithm.SHA256,
      hash: createHashLockHashBytes,
      expiration: createHashLockExpirationAt,
    );
    createHashLockLock.validateForSubmit();
    print('Hash lock ready:');
    print('  algorithm: \${createHashLockHashAlgorithm}');
    print('  hash:      \${createHashLockHash}');
    print('  expires:   \${createHashLockExpirationIso} (unix \${createHashLockExpiration})');
    print('  PREIMAGE:  \${createHashLockPreimage}');


    // =========================================================
    // SendTokens (SendTokens, hash-locked)
    // =========================================================
    // Hash-locked send: the sender is debited now and the recipient is credited only
    // when a ReleaseLockedOperation reveals the preimage.
    final lockedSendSigner = SmartSigner(
      client: client.v3,
      keypair: generateKeysKey,
      signerUrl: '\${createIdentityUrl}/book/1',
    );
    final lockedSendResult = await lockedSendSigner.signSubmitAndWait(
      principal: createSenderAccountUrl.toString(),
      body: TxBody.sendTokensSingle(
        toUrl: createReceiverAccountUrl.toString(),
        amount: lock_amount,
      ),
      hashLock: createHashLockLock,
      memo: 'Locked send',
      maxAttempts: 45,
    );
    final lockedSendTxId = await confirmDelivered(client.v3, 'SendTokens (hash-locked)', lockedSendResult);
    print('SendTokens LOCKED - TxID: \${lockedSendTxId}');
    txIds.add(MapEntry('SendTokens (hash-locked)', lockedSendTxId));


    // =========================================================
    // WaitForLockedDeposit (WaitForLockedDeposit)
    // =========================================================
    // A release targets the locked DEPOSIT, not the send. The deposit is one of the
    // send's produced transactions. A query error just means it is not ready yet, and
    // \`produced.total\` can over-count, so scan the records themselves.
    final waitForLockedDepositSendTxId = lockedSendTxId;
    String? waitForLockedDepositLockedTxId;
    print('Waiting for the locked deposit produced by \${waitForLockedDepositSendTxId}...');
    for (var attempt = 1; attempt <= 60 && waitForLockedDepositLockedTxId == null; attempt++) {
      try {
        final sendRec = await queryScope(client.v3, waitForLockedDepositSendTxId);
        final records = (sendRec['produced']?['records'] as List?) ?? const [];
        for (final rec in records) {
          final id = rec is Map ? rec['value'] : null;
          if (id is! String) continue;
          try {
            final dep = await queryScope(client.v3, id);
            final type = dep['message']?['transaction']?['body']?['type'];
            if (type == 'syntheticLockedDeposit' && dep['status'] == 'delivered') {
              waitForLockedDepositLockedTxId = id;
              break;
            }
          } catch (_) {
            // produced id not found yet
          }
        }
      } catch (_) {
        // send not queryable yet
      }
      if (waitForLockedDepositLockedTxId == null) {
        print('  Waiting for locked deposit... (attempt $attempt/60)');
        await Future.delayed(Duration(milliseconds: 2000));
      }
    }
    if (waitForLockedDepositLockedTxId == null) fail('the locked deposit was not delivered in time');
    print('Locked deposit: \${waitForLockedDepositLockedTxId}');
    txIds.add(MapEntry('LockedDeposit', waitForLockedDepositLockedTxId));


    // =========================================================
    // ReleaseLockedOperation (ReleaseLockedOperation)
    // =========================================================
    // The RECIPIENT account releases the deposit and pays the small fee, so the signer
    // needs credits. A wrong preimage or an expired lock is accepted at submit and only
    // fails when the transaction executes; confirmDelivered checks the final status.
    final releaseLockedSigner = SmartSigner(
      client: client.v3,
      keypair: generateKeysKey,
      signerUrl: '\${createIdentityUrl}/book/1',
    );
    final releaseLockedResult = await releaseLockedSigner.signSubmitAndWait(
      principal: createReceiverAccountUrl.toString(),
      body: TxBody.releaseLockedOperation(
        lockedTxId: waitForLockedDepositLockedTxId,
        preimage: fromHex(createHashLockPreimage),
      ),
      memo: 'Release locked',
      maxAttempts: 45,
    );
    final releaseLockedTxId = await confirmDelivered(client.v3, 'ReleaseLockedOperation', releaseLockedResult);
    print('ReleaseLockedOperation SUCCESS - TxID: \${releaseLockedTxId}');
    txIds.add(MapEntry('ReleaseLockedOperation', releaseLockedTxId));


    // =========================================================
    // WaitForBalance (WaitForBalance)
    // =========================================================
    print('Waiting for balance >= 1.00000000...');
    final waitForReceiverBalanceMinBal = BigInt.parse('1.00000000'.replaceAll('.', ''));
    for (var i = 0; i < 30; i++) {
      try {
        final result = await client.v3.rawCall('query', {
          'scope': createReceiverAccountUrl.toString(),
          'query': {'queryType': 'default'},
        });
        final balance = result['account']?['balance'];
        if (balance != null && BigInt.parse(balance.toString()) >= waitForReceiverBalanceMinBal) break;
      } catch (_) {}
      await Future.delayed(Duration(seconds: 2));
    }
    print('Balance reached');


    print('\\n========== Transaction Summary ==========');
    for (final entry in txIds) {
      print('  \${entry.key}: \${entry.value}');
    }
    print('Flow completed successfully!');
  } finally {
    client.close();
  }
}
"
`;

