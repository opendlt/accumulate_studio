        txIds.add(MapEntry('UpdateKeyPage', addSigner_3Result.txid!));
      }
    } else {
      print('UpdateKeyPage FAILED: \${addSigner_3Result.error}');
    }


    // =========================================================
    // UpdateKeyPage (Action: UpdateKeyPage)
    // =========================================================
    final setThresholdSigner = SmartSigner(
      client: client.v3,
