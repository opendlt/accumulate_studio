exports[`Codegen Snapshots > csharp SDK > hash-lock generates expected csharp code 1`] = `
"// Hash Lock (HTLC) Payment
// Generated by Accumulate Studio
// Network: devnet
//
// NuGet packages:
//   dotnet add package Acme.Net.Sdk
//
// Run with: dotnet run

using System;
using System.Collections.Generic;
using System.Security.Cryptography;
using System.Text.Json;
using System.Threading.Tasks;
using Acme.Net.Sdk;
using Acme.Net.Sdk.Protocol;
using Acme.Net.Sdk.Protocol.Generated;
using Acme.Net.Sdk.Signing;
using Acme.Net.Sdk.Transactions;
using Acme.Net.Sdk.Helpers;

class Program
{
    // Print the reason and stop with a non-zero exit code: a failed HTLC step must never look like success.
    [System.Diagnostics.CodeAnalysis.DoesNotReturn]
    static void Fail(string message)
    {
        Console.Error.WriteLine($"FAILED: {message}");
        Environment.Exit(1);
    }

    // Walks a path of object properties; null if any segment is missing.
    static JsonElement? Dig(JsonElement e, params string[] path)
    {
        var cur = e;
        foreach (var key in path)
        {
            if (cur.ValueKind != JsonValueKind.Object || !cur.TryGetProperty(key, out var next)) return null;
            cur = next;
        }
        return cur;
    }

    static string? Str(JsonElement e, params string[] path)
    {
        var v = Dig(e, path);
        return v is { ValueKind: JsonValueKind.String } s ? s.GetString() : null;
    }

    static async Task Main(string[] args)
    {
        var baseUrl = Environment.GetEnvironmentVariable("ACCUMULATE_BASE_URL")
            ?? "https://kermit.accumulatenetwork.io";
        using var client = new Accumulate(baseUrl);
        var helper = new AccumulateHelper(client);
        var txIds = new List<(string Label, string TxId)>();
        try
        {
            // Flow variables (customize these for your use case)
            var adi_name = $"adi-{DateTimeOffset.UtcNow.ToUnixTimeSeconds()}-{Random.Shared.Next(0x1000000):x6}";  // 
            var lock_amount = "100000000";  // 


            // =========================================================
            // GenerateKeys (GenerateKeys)
            // =========================================================
            var generateKeysKp = AccKeyPairGenerator.GenerateSignatureKeyPair(SignatureType.ED25519);
            var generateKeysLid = Principal.ComputeUrl(generateKeysKp.GetPublicKey());
            var generateKeysLta = Principal.ComputeUrl(generateKeysKp.GetPublicKey(), new Url("acc://ACME"));
            var generateKeysPubKey = generateKeysKp.GetPublicKey();
            var generateKeysPubHash = Convert.ToHexString(SHA256.HashData(generateKeysPubKey)).ToLowerInvariant();
            Console.WriteLine("Generated keypair:");
            Console.WriteLine($"  Lite Identity: {generateKeysLid}");
            Console.WriteLine($"  Lite Token Account: {generateKeysLta}");
            Console.WriteLine($"  Public Key Hash: {generateKeysPubHash}");


            // =========================================================
            // Faucet (Faucet)
            // =========================================================
            Console.WriteLine("Requesting tokens from faucet...");
            for (int i = 0; i < 3; i++)
            {
                try
                {
                    var resp = await client.V2.FaucetAsync(generateKeysLta.String());
                    Console.WriteLine($"  Faucet {i + 1}/3: submitted");
                    await Task.Delay(2000);
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"  Faucet {i + 1}/3 failed: {ex.Message}");
                }
            }
            Console.WriteLine("Faucet request completed");


            // =========================================================
            // WaitForBalance (WaitForBalance)
            // =========================================================
            Console.WriteLine("Waiting for balance >= 15.00000000...");
            await helper.PollForBalanceAsync(generateKeysLta.String());
            Console.WriteLine("Balance reached");


            // =========================================================
            // AddCredits (Action: AddCredits)
            // =========================================================
            var addCreditsOracle = await helper.GetOracleAsync();
            var addCreditsSigner = new SmartSigner(client.V3, generateKeysKp, generateKeysLid.String());
            var addCreditsResult = await addCreditsSigner.SignSubmitAndWaitAsync(
                generateKeysLta.String(),
                TxBody.AddCredits(
                    generateKeysLid.String(),
                    "500000000",
                    addCreditsOracle
                )
            );
            if (addCreditsResult.Success)
            {
                Console.WriteLine($"AddCredits SUCCESS - TxID: {addCreditsResult.TxId}");
                if (addCreditsResult.TxId != null) txIds.Add(("AddCredits", addCreditsResult.TxId));
            }
            else
            {
                Console.WriteLine($"AddCredits FAILED: {addCreditsResult.Error}");
            }


            // =========================================================
            // WaitForCredits (WaitForCredits)
            // =========================================================
            Console.WriteLine("Waiting for credits >= 1000...");
            await helper.PollForCreditsAsync(generateKeysLid.String());
            Console.WriteLine("Credits reached");


            // =========================================================
            // CreateIdentity (Action: CreateIdentity)
            // =========================================================
            var createIdentityUrl = $"acc://{adi_name}.acme";
            var createIdentitySigner = new SmartSigner(client.V3, generateKeysKp, generateKeysLid.String());
            var createIdentityResult = await createIdentitySigner.SignSubmitAndWaitAsync(
                generateKeysLta.String(),
                TxBody.CreateIdentity(
                    createIdentityUrl,
                    $"{createIdentityUrl}/book",
                    generateKeysPubHash
                )
            );
            if (createIdentityResult.Success)
            {
                Console.WriteLine($"CreateIdentity SUCCESS - TxID: {createIdentityResult.TxId}");
                if (createIdentityResult.TxId != null) txIds.Add(("CreateIdentity", createIdentityResult.TxId));
            }
            else
            {
                Console.WriteLine($"CreateIdentity FAILED: {createIdentityResult.Error}");
            }


            // =========================================================
            // AddCredits (Action: AddCredits)
            // =========================================================
            var addAdiCreditsOracle = await helper.GetOracleAsync();
            var addAdiCreditsSigner = new SmartSigner(client.V3, generateKeysKp, generateKeysLid.String());
            var addAdiCreditsResult = await addAdiCreditsSigner.SignSubmitAndWaitAsync(
                generateKeysLta.String(),
                TxBody.AddCredits(
                    $"{createIdentityUrl}/book/1",
                    "500000000",
                    addAdiCreditsOracle
                )
            );
            if (addAdiCreditsResult.Success)
            {
                Console.WriteLine($"AddCredits SUCCESS - TxID: {addAdiCreditsResult.TxId}");
                if (addAdiCreditsResult.TxId != null) txIds.Add(("AddCredits", addAdiCreditsResult.TxId));
            }
            else
            {
                Console.WriteLine($"AddCredits FAILED: {addAdiCreditsResult.Error}");
            }


            // =========================================================
            // WaitForCredits (WaitForCredits)
            // =========================================================
            Console.WriteLine("Waiting for credits >= 1000...");
            await helper.PollForCreditsAsync($"{createIdentityUrl}/book/1");
            Console.WriteLine("Credits reached");


            // =========================================================
            // CreateTokenAccount (Action: CreateTokenAccount)
            // =========================================================
            var createSenderAccountUrl = $"acc://{adi_name}.acme/htlc-sender";
            var createSenderAccountSigner = new SmartSigner(client.V3, generateKeysKp, $"{createIdentityUrl}/book/1");
            var createSenderAccountResult = await createSenderAccountSigner.SignSubmitAndWaitAsync(
                createIdentityUrl,
                TxBody.CreateTokenAccount(
                    $"acc://{adi_name}.acme/htlc-sender",
                    "acc://ACME"
                )
            );
            if (createSenderAccountResult.Success)
            {
                Console.WriteLine($"CreateTokenAccount SUCCESS - TxID: {createSenderAccountResult.TxId}");
                if (createSenderAccountResult.TxId != null) txIds.Add(("CreateTokenAccount", createSenderAccountResult.TxId));
            }
            else
            {
                Console.WriteLine($"CreateTokenAccount FAILED: {createSenderAccountResult.Error}");
            }


            // =========================================================
            // CreateTokenAccount (Action: CreateTokenAccount)
            // =========================================================
            var createReceiverAccountUrl = $"acc://{adi_name}.acme/htlc-receiver";
            var createReceiverAccountSigner = new SmartSigner(client.V3, generateKeysKp, $"{createIdentityUrl}/book/1");
            var createReceiverAccountResult = await createReceiverAccountSigner.SignSubmitAndWaitAsync(
                createIdentityUrl,
                TxBody.CreateTokenAccount(
                    $"acc://{adi_name}.acme/htlc-receiver",
                    "acc://ACME"
                )
            );
            if (createReceiverAccountResult.Success)
            {
                Console.WriteLine($"CreateTokenAccount SUCCESS - TxID: {createReceiverAccountResult.TxId}");
                if (createReceiverAccountResult.TxId != null) txIds.Add(("CreateTokenAccount", createReceiverAccountResult.TxId));
            }
            else
            {
                Console.WriteLine($"CreateTokenAccount FAILED: {createReceiverAccountResult.Error}");
            }


            // =========================================================
            // SendTokens (Action: SendTokens)
            // =========================================================
            var fundSenderSigner = new SmartSigner(client.V3, generateKeysKp, generateKeysLid.String());
            var fundSenderResult = await fundSenderSigner.SignSubmitAndWaitAsync(
                generateKeysLta.String(),
                TxBody.SendTokensSingle(
                    createSenderAccountUrl,
                    "500000000"
                )
            );
            if (fundSenderResult.Success)
            {
                Console.WriteLine($"SendTokens SUCCESS - TxID: {fundSenderResult.TxId}");
                if (fundSenderResult.TxId != null) txIds.Add(("SendTokens", fundSenderResult.TxId));
            }
            else
            {
                Console.WriteLine($"SendTokens FAILED: {fundSenderResult.Error}");
            }


            // =========================================================
            // WaitForBalance (WaitForBalance)
            // =========================================================
            Console.WriteLine("Waiting for balance >= 1.00000000...");
            await helper.PollForBalanceAsync(createSenderAccountUrl);
            Console.WriteLine("Balance reached");


            // =========================================================
            // GenerateHashLock (GenerateHashLock)
            // =========================================================
            // The lock is a hash of a secret preimage. The preimage stays with you until the
            // release transaction reveals it on-chain.
            var createHashLockPreimageBytes = RandomNumberGenerator.GetBytes(32);
            var createHashLockPreimage = Convert.ToHexString(createHashLockPreimageBytes).ToLowerInvariant();
            var createHashLockHashBytes = SHA256.HashData(createHashLockPreimageBytes);
            var createHashLockHash = Convert.ToHexString(createHashLockHashBytes).ToLowerInvariant();
            var createHashLockHashAlgorithm = "sha256";
            // Whole seconds in UTC: the node needs 10 minutes to 30 days of headroom and rejects fractions
            var createHashLockExpirationAt = DateTimeOffset.FromUnixTimeSeconds(DateTimeOffset.UtcNow.AddMinutes(30).ToUnixTimeSeconds());
            var createHashLockExpiration = createHashLockExpirationAt.ToUnixTimeSeconds();
            var createHashLockExpirationIso = createHashLockExpirationAt.UtcDateTime.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'");
            // The signer takes the dictionary form, which does no validation, so validate the
            // typed form built from the same three values first.
            try
            {
                new HashLockOptions
                {
                    HashAlgorithm = HashLockAlgorithm.SHA256,
                    Hash = createHashLockHashBytes,
                    Expiration = createHashLockExpirationAt,
                }.ValidateForSubmit();
            }
            catch (ArgumentException ex)
            {
                Fail($"invalid hash lock: {ex.Message}");
            }
            var createHashLockLock = new HeaderOptions { HashLock = TxBody.HashLock(createHashLockHashAlgorithm, createHashLockHash, createHashLockExpirationAt) };
            Console.WriteLine("Hash lock ready:");
            Console.WriteLine($"  algorithm: {createHashLockHashAlgorithm}");
            Console.WriteLine($"  hash:      {createHashLockHash}");
            Console.WriteLine($"  expires:   {createHashLockExpirationIso}");
            Console.WriteLine($"  PREIMAGE:  {createHashLockPreimage}");


            // =========================================================
            // SendTokens (SendTokens, hash-locked)
            // =========================================================
            // Hash-locked send: the sender is debited now and the recipient is credited only
            // when a ReleaseLockedOperation reveals the preimage.
            var lockedSendSigner = new SmartSigner(client.V3, generateKeysKp, $"{createIdentityUrl}/book/1");
            var lockedSendResult = await lockedSendSigner.SignSubmitAndWaitAsync(
                createSenderAccountUrl,
                TxBody.SendTokensSingle(
                    createReceiverAccountUrl,
                    lock_amount
                ),
                headerOptions: createHashLockLock,
                maxAttempts: 45
            );
            if (!lockedSendResult.Success || lockedSendResult.TxId == null)
                Fail($"SendTokens (hash-locked) failed: {lockedSendResult.Error}");
            var lockedSendTxId = lockedSendResult.TxId!;
            Console.WriteLine($"SendTokens LOCKED - TxID: {lockedSendTxId}");
            txIds.Add(("SendTokens (hash-locked)", lockedSendTxId));


            // =========================================================
            // WaitForLockedDeposit (WaitForLockedDeposit)
            // =========================================================
            // A release targets the locked DEPOSIT, not the send. The deposit is one of the
            // send's produced transactions. A query error just means it is not ready yet, and
            // \`produced.total\` can over-count, so scan the records themselves.
            var waitForLockedDepositSendTxId = lockedSendTxId;
            string? waitForLockedDepositLockedTxId = null;
            Console.WriteLine($"Waiting for the locked deposit produced by {waitForLockedDepositSendTxId}...");
            for (int attempt = 1; attempt <= 60 && waitForLockedDepositLockedTxId == null; attempt++)
            {
                try
                {
                    var sendQuery = await client.V3.QueryTransactionAsync(waitForLockedDepositSendTxId);
                    if (Dig(sendQuery, "produced", "records") is { ValueKind: JsonValueKind.Array } records)
                    {
                        foreach (var rec in records.EnumerateArray())
                        {
                            var producedId = Str(rec, "value");
                            if (producedId == null) continue;
                            try
                            {
                                var dep = await client.V3.QueryTransactionAsync(producedId);
                                if (Str(dep, "message", "transaction", "body", "type") == "syntheticLockedDeposit"
                                    && Str(dep, "status") == "delivered")
                                {
                                    waitForLockedDepositLockedTxId = producedId;
                                    break;
                                }
                            }
                            catch
                            {
                                // produced id not found yet
                            }
                        }
                    }
                }
                catch
                {
                    // send not queryable yet
                }
                if (waitForLockedDepositLockedTxId == null)
                {
                    Console.WriteLine($"  Waiting for locked deposit... (attempt {attempt}/60)");
                    await Task.Delay(2000);
                }
            }
            if (waitForLockedDepositLockedTxId == null) Fail("the locked deposit was not delivered in time");
            Console.WriteLine($"Locked deposit: {waitForLockedDepositLockedTxId}");
            txIds.Add(("LockedDeposit", waitForLockedDepositLockedTxId!));


            // =========================================================
            // ReleaseLockedOperation (ReleaseLockedOperation)
            // =========================================================
            // The RECIPIENT account releases the deposit and pays the small fee, so the signer
            // needs credits. A wrong preimage or an expired lock is accepted at submit and only
            // fails when the transaction executes; the SDK wait reports that failure.
            var releaseLockedSigner = new SmartSigner(client.V3, generateKeysKp, $"{createIdentityUrl}/book/1");
            var releaseLockedResult = await releaseLockedSigner.SignSubmitAndWaitAsync(
                createReceiverAccountUrl,
                TxBody.ReleaseLockedOperation(waitForLockedDepositLockedTxId, createHashLockPreimage),
                maxAttempts: 45
            );
            if (releaseLockedResult.TxId != null) txIds.Add(("ReleaseLockedOperation", releaseLockedResult.TxId));
            if (!releaseLockedResult.Success || releaseLockedResult.TxId == null)
                Fail($"ReleaseLockedOperation failed: {releaseLockedResult.Error}");
            Console.WriteLine($"ReleaseLockedOperation SUCCESS - TxID: {releaseLockedResult.TxId}");


            // =========================================================
            // WaitForBalance (WaitForBalance)
            // =========================================================
            Console.WriteLine("Waiting for balance >= 1.00000000...");
            await helper.PollForBalanceAsync(createReceiverAccountUrl);
            Console.WriteLine("Balance reached");


            Console.WriteLine("\\n========== Transaction Summary ==========");
            foreach (var (label, txid) in txIds)
            {
                Console.WriteLine($"  {label}: {txid}");
            }
            Console.WriteLine("Flow completed successfully!");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Flow failed: {ex.Message}");
        }
    }
}
"
`;

