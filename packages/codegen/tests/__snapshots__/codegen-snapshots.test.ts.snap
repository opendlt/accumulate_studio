"// Custom Token Issuance
// Generated by Accumulate Studio
// Network: devnet
//
// NuGet packages:
//   dotnet add package Acme.Net.Sdk
//
// Run with: dotnet run

using System;
using System.Collections.Generic;
using System.Security.Cryptography;
using System.Text.Json;
using System.Threading.Tasks;
using Acme.Net.Sdk;
using Acme.Net.Sdk.Protocol;
using Acme.Net.Sdk.Protocol.Generated;
using Acme.Net.Sdk.Signing;
using Acme.Net.Sdk.Transactions;
using Acme.Net.Sdk.Helpers;

class Program
{
    static async Task Main(string[] args)
    {
        var baseUrl = Environment.GetEnvironmentVariable("ACCUMULATE_BASE_URL")
            ?? "https://kermit.accumulatenetwork.io";
        using var client = new Accumulate(baseUrl);
        var helper = new AccumulateHelper(client);
        var txIds = new List<(string Label, string TxId)>();
        try
        {
            // Flow variables (customize these for your use case)
            var adi_url = "";  // 
            var token_symbol = "TKN";  // 
            var token_precision = "";  // 
            var supply_limit = "";  // 
            var initial_issue_amount = "100000000000";  // 
            var recipient_url = "";  // 


            // =========================================================
            // CreateToken (Action: CreateToken)
            // =========================================================
            var createTokenUrl = $"{adi_url}/{token_symbol}";
            var createTokenSigner = new SmartSigner(client.V3, createTokenKp, createTokenLid.String());
            var createTokenResult = await createTokenSigner.SignSubmitAndWaitAsync(
                adi_url,
                TxBody.CreateToken(
                    $"{adi_url}/{token_symbol}",
                    token_symbol,
                    token_precision
                )
            );
            if (createTokenResult.Success)
            {
                Console.WriteLine($"CreateToken SUCCESS - TxID: {createTokenResult.TxId}");
                if (createTokenResult.TxId != null) txIds.Add(("CreateToken", createTokenResult.TxId));
            }
            else
            {
                Console.WriteLine($"CreateToken FAILED: {createTokenResult.Error}");
            }


            // =========================================================
            // IssueTokens (Action: IssueTokens)
            // =========================================================
            var issueTokensSigner = new SmartSigner(client.V3, issueTokensKp, issueTokensLid.String());
            var issueTokensResult = await issueTokensSigner.SignSubmitAndWaitAsync(
                $"{adi_url}/{token_symbol}",
                TxBody.IssueTokens(
                    recipient_url,
                    initial_issue_amount
                )
            );
            if (issueTokensResult.Success)
            {
                Console.WriteLine($"IssueTokens SUCCESS - TxID: {issueTokensResult.TxId}");
                if (issueTokensResult.TxId != null) txIds.Add(("IssueTokens", issueTokensResult.TxId));
            }
            else
            {
                Console.WriteLine($"IssueTokens FAILED: {issueTokensResult.Error}");
            }


            // =========================================================
            // QueryAccount (QueryAccount)
            // =========================================================
            var queryTokenResult = await client.V3.QueryAccountAsync($"{adi_url}/{token_symbol}");
            Console.WriteLine($"Account state: {JsonSerializer.Serialize(queryTokenResult, new JsonSerializerOptions { WriteIndented = true })}");


            // =========================================================
            // SendTokens (Action: SendTokens)
            // =========================================================
            var sendTokensSigner = new SmartSigner(client.V3, sendTokensKp, sendTokensLid.String());
            var sendTokensResult = await sendTokensSigner.SignSubmitAndWaitAsync(
                recipient_url,
                TxBody.SendTokensSingle(
                    recipient_url,
                    "100.00000000"
                )
            );
            if (sendTokensResult.Success)
            {
                Console.WriteLine($"SendTokens SUCCESS - TxID: {sendTokensResult.TxId}");
                if (sendTokensResult.TxId != null) txIds.Add(("SendTokens", sendTokensResult.TxId));
            }
            else
            {
                Console.WriteLine($"SendTokens FAILED: {sendTokensResult.Error}");
            }


            Console.WriteLine("\\n========== Transaction Summary ==========");
            foreach (var (label, txid) in txIds)
            {
                Console.WriteLine($"  {label}: {txid}");
            }
            Console.WriteLine("Flow completed successfully!");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Flow failed: {ex.Message}");
        }
    }
}
"
`;

