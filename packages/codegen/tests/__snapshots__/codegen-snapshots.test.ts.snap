using System.Security.Cryptography;
using System.Text.Json;
using System.Threading.Tasks;
using Acme.Net.Sdk;
using Acme.Net.Sdk.Protocol;
using Acme.Net.Sdk.Protocol.Generated;
using Acme.Net.Sdk.Signing;
using Acme.Net.Sdk.Transactions;
using Acme.Net.Sdk.Helpers;

class Program
{
    static async Task Main(string[] args)
    {
        var baseUrl = Environment.GetEnvironmentVariable("ACCUMULATE_BASE_URL")
            ?? "https://kermit.accumulatenetwork.io";
        using var client = new Accumulate(baseUrl);
        var helper = new AccumulateHelper(client);
        var txIds = new List<(string Label, string TxId)>();
        try
        {
            // Flow variables (customize these for your use case)
            var key_page_url = "";  // 
            var old_public_key_hash = "";  // 


            // =========================================================
            // GenerateKeys (GenerateKeys)
            // =========================================================
            var generateNewKeysKp = AccKeyPairGenerator.GenerateSignatureKeyPair(SignatureType.ED25519);
            var generateNewKeysLid = Principal.ComputeUrl(generateNewKeysKp.GetPublicKey());
            var generateNewKeysLta = Principal.ComputeUrl(generateNewKeysKp.GetPublicKey(), new Url("acc://ACME"));
            var generateNewKeysPubKey = generateNewKeysKp.GetPublicKey();
            var generateNewKeysPubHash = Convert.ToHexString(SHA256.HashData(generateNewKeysPubKey)).ToLowerInvariant();
            Console.WriteLine("Generated keypair:");
            Console.WriteLine($"  Lite Identity: {generateNewKeysLid}");
            Console.WriteLine($"  Lite Token Account: {generateNewKeysLta}");
            Console.WriteLine($"  Public Key Hash: {generateNewKeysPubHash}");


            // =========================================================
            // UpdateKey (Action: UpdateKey)
            // =========================================================
            var updateKeySigner = new SmartSigner(client.V3, generateNewKeysKp, generateNewKeysLid.String());
            var updateKeyResult = await updateKeySigner.SignSubmitAndWaitAsync(
                key_page_url,
                TxBody.UpdateKey(generateNewKeysPubHash)
            );
            if (updateKeyResult.Success)
            {
                Console.WriteLine($"UpdateKey SUCCESS - TxID: {updateKeyResult.TxId}");
                if (updateKeyResult.TxId != null) txIds.Add(("UpdateKey", updateKeyResult.TxId));
            }
            else
            {
                Console.WriteLine($"UpdateKey FAILED: {updateKeyResult.Error}");
            }


            // =========================================================
            // QueryAccount (QueryAccount)
            // =========================================================
            var verifyKeyPageResult = await client.V3.QueryAccountAsync(key_page_url);
            Console.WriteLine($"Account state: {JsonSerializer.Serialize(verifyKeyPageResult, new JsonSerializerOptions { WriteIndented = true })}");


            Console.WriteLine("\\n========== Transaction Summary ==========");
            foreach (var (label, txid) in txIds)
            {
                Console.WriteLine($"  {label}: {txid}");
            }
            Console.WriteLine("Flow completed successfully!");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Flow failed: {ex.Message}");
        }
    }
}
