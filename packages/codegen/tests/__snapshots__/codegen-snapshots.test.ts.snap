"// Lite Account Setup
// Generated by Accumulate Studio
// Network: devnet
//
// NuGet packages:
//   dotnet add package Acme.Net.Sdk
//
// Run with: dotnet run

using System;
using System.Collections.Generic;
using System.Security.Cryptography;
using System.Text.Json;
using System.Threading.Tasks;
using Acme.Net.Sdk;
using Acme.Net.Sdk.Protocol;
using Acme.Net.Sdk.Protocol.Generated;
using Acme.Net.Sdk.Signing;
using Acme.Net.Sdk.Transactions;
using Acme.Net.Sdk.Helpers;

class Program
{
    static async Task Main(string[] args)
    {
        var baseUrl = Environment.GetEnvironmentVariable("ACCUMULATE_BASE_URL")
            ?? "https://kermit.accumulatenetwork.io";
        using var client = new Accumulate(baseUrl);
        var helper = new AccumulateHelper(client);
        var txIds = new List<(string Label, string TxId)>();
        try
        {


            // =========================================================
            // GenerateKeys (GenerateKeys)
            // =========================================================
            var generateKeysKp = AccKeyPairGenerator.GenerateSignatureKeyPair(SignatureType.ED25519);
            var generateKeysLid = Principal.ComputeUrl(generateKeysKp.GetPublicKey());
            var generateKeysLta = Principal.ComputeUrl(generateKeysKp.GetPublicKey(), new Url("acc://ACME"));
            var generateKeysPubKey = generateKeysKp.GetPublicKey();
            var generateKeysPubHash = Convert.ToHexString(SHA256.HashData(generateKeysPubKey)).ToLowerInvariant();
            Console.WriteLine("Generated keypair:");
            Console.WriteLine($"  Lite Identity: {generateKeysLid}");
            Console.WriteLine($"  Lite Token Account: {generateKeysLta}");
            Console.WriteLine($"  Public Key Hash: {generateKeysPubHash}");


            // =========================================================
            // Faucet (Faucet)
            // =========================================================
            Console.WriteLine("Requesting tokens from faucet...");
            for (int i = 0; i < 1; i++)
            {
                try
                {
                    var resp = await client.V2.FaucetAsync(generateKeysLta.String());
                    Console.WriteLine($"  Faucet {i + 1}/1: submitted");
                    await Task.Delay(2000);
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"  Faucet {i + 1}/1 failed: {ex.Message}");
                }
            }
            Console.WriteLine("Faucet request completed");


            // =========================================================
            // WaitForBalance (WaitForBalance)
            // =========================================================
            Console.WriteLine("Waiting for balance >= 5.00000000...");
            await helper.PollForBalanceAsync(generateKeysLta.String());
            Console.WriteLine("Balance reached");


            Console.WriteLine("\\n========== Transaction Summary ==========");
            foreach (var (label, txid) in txIds)
            {
                Console.WriteLine($"  {label}: {txid}");
            }
            Console.WriteLine("Flow completed successfully!");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Flow failed: {ex.Message}");
        }
    }
}
"
