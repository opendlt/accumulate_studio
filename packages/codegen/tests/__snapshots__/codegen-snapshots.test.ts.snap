      maxAttempts: 30,
    );
    if (createDataAccountResult.success) {
      print('CreateDataAccount SUCCESS - TxID: \${createDataAccountResult.txid}');
      if (createDataAccountResult.txid != null) {
        txIds.add(MapEntry('CreateDataAccount', createDataAccountResult.txid!));
      }
    } else {
      print('CreateDataAccount FAILED: \${createDataAccountResult.error}');
    }


    // =========================================================
    // WriteData (Action: WriteData)
    // =========================================================
    final writeDataSigner = SmartSigner(
      client: client.v3,
      keypair: writeDataKey,
      signerUrl: writeDataLid.toString(),
    );
    final writeDataResult = await writeDataSigner.signSubmitAndWait(
      principal: '\${adi_url}/\${data_account_name}',
      body: TxBody.writeData(entriesHex: [data_content]),
      memo: 'Write data',
      maxAttempts: 30,
    );
    if (writeDataResult.success) {
      print('WriteData SUCCESS - TxID: \${writeDataResult.txid}');
      if (writeDataResult.txid != null) {
        txIds.add(MapEntry('WriteData', writeDataResult.txid!));
      }
    } else {
      print('WriteData FAILED: \${writeDataResult.error}');
    }


    // =========================================================
    // QueryAccount (QueryAccount)
    // =========================================================
    try {
      final queryAccountResult = await client.v3.rawCall('query', {
        'scope': '\${adi_url}/\${data_account_name}',
        'query': {'queryType': 'default'},
      });
      print('Account state: \${queryAccountResult}');
    } catch (e) {
      print('Query failed: $e');
    }


    print('\\n========== Transaction Summary ==========');
    for (final entry in txIds) {
      print('  \${entry.key}: \${entry.value}');
    }
    print('Flow completed successfully!');
  } finally {
    client.close();
  }
}
"
`;

