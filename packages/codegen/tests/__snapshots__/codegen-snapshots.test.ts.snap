exports[`Codegen Snapshots > javascript SDK > hash-lock generates expected javascript code 1`] = `
"/**
 * Hash Lock (HTLC) Payment
 * Generated by Accumulate Studio
 * Network: devnet
 *
 * Install: npm install accumulate-sdk-opendlt
 * Run with: node script.mjs
 */

import { createHash, randomBytes } from "node:crypto";
import {
    Accumulate,
    SmartSigner,
    TxBody,
    Ed25519KeyPair,
    KERMIT_V2,
    KERMIT_V3,
    pollForBalance,
    pollForCredits,
    core,
    helpers,
} from "accumulate-sdk-opendlt";

const V2_ENDPOINT = process.env.ACCUMULATE_V2_URL || KERMIT_V2;
const V3_ENDPOINT = process.env.ACCUMULATE_V3_URL || KERMIT_V3;

const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

// Stop the flow with a non-zero exit code. The caller's catch prints the message.
function fail(message) {
    process.exitCode = 1;
    throw new Error(message);
}

// Hex goes through Buffer.from(hex, "hex"), which silently truncates at the first invalid
// character, so check every hex value before it reaches the SDK.
function requireHex(label, hex, minBytes, maxBytes) {
    const ok = typeof hex === "string" && /^[0-9a-fA-F]+$/.test(hex) && hex.length % 2 === 0
        && hex.length >= minBytes * 2 && hex.length <= maxBytes * 2;
    if (!ok) fail(\`\${label} must be \${minBytes === maxBytes ? minBytes : \`\${minBytes} to \${maxBytes}\`} bytes of hex\`);
    return hex;
}

// Raw v3 query (plain JSON where status is a string such as "delivered").
const v3Query = (client, scope) => client.v3.call("query", { scope });

// The SDK wait cannot be trusted on its own (its V3 fallback never detects delivery), so
// every transaction is confirmed with a raw v3 query: status "delivered" and no error.
async function settle(client, txid, attempts) {
    let last;
    for (let i = 0; i < attempts; i++) {
        try {
            last = await v3Query(client, txid);
            if (last.status === "delivered" && !last.error) return { ok: true };
            if (last.error || (last.status !== "pending" && last.status !== "remote")) {
                return { ok: false, message: last.error?.message ?? \`status \${last.status}\` };
            }
        } catch {
            // not indexed yet
        }
        if (i < attempts - 1) await sleep(2000);
    }
    return { ok: false, message: last ? \`status \${last.status}\` : "not found" };
}

// Sign, submit and wait, then confirm the final status; stop the flow on any failure.
async function submitAndConfirm(client, label, signer, principal, body, options) {
    const result = await signer.signSubmitAndWait(principal, body, { maxAttempts: 45, ...options });
    if (!result.txid) fail(\`\${label} failed: \${result.error}\`);
    const final = await settle(client, result.txid, result.success ? 45 : 1);
    if (!final.ok) fail(\`\${label} failed: \${final.message}\`);
    return result.txid;
}

async function main() {
    const client = Accumulate.custom(V2_ENDPOINT, V3_ENDPOINT);
    const txIds = [];
    try {
        const adi_name = \`adi-\${Math.floor(Date.now() / 1000)}-\${Math.floor(Math.random() * 0x1000000).toString(16).padStart(6, "0")}\`;  // 
        const lock_amount = "100000000";  // 


        // =========================================================
        // GenerateKeys (GenerateKeys)
        // =========================================================
        const generateKeysKp = Ed25519KeyPair.generate();
        const generateKeysLid = generateKeysKp.deriveLiteIdentityUrl();
        const generateKeysLta = generateKeysKp.deriveLiteTokenAccountUrl();
        const generateKeysPubHash = generateKeysKp.publicKeyHashHex();
        console.log("Generated keypair:");
        console.log(\`  Lite Identity: \${generateKeysLid}\`);
        console.log(\`  Lite Token Account: \${generateKeysLta}\`);
        console.log(\`  Public Key Hash: \${generateKeysPubHash}\`);


        // =========================================================
        // Faucet (Faucet)
        // =========================================================
        console.log("Requesting tokens from faucet...");
        await client.faucet(generateKeysLta, 3, 2000);
        console.log("Faucet request completed");


        // =========================================================
        // WaitForBalance (WaitForBalance)
        // =========================================================
        console.log("Waiting for balance >= 15.00000000...");
        await pollForBalance(client, generateKeysLta, 15.00000000);
        console.log("Balance reached");


        // =========================================================
        // AddCredits (Action: AddCredits)
        // =========================================================
        const addCreditsOracle = await client.getOraclePrice();
        const addCreditsSigner = new SmartSigner(client, generateKeysKp.toKey(), generateKeysLid);
        const addCreditsResult = await addCreditsSigner.signSubmitAndWait(
            generateKeysLta,
            TxBody.addCredits(
                generateKeysLid,
                "500000000",
                addCreditsOracle,
            ),
        );
        if (addCreditsResult.success) {
            console.log(\`AddCredits SUCCESS - TxID: \${addCreditsResult.txid}\`);
            if (addCreditsResult.txid) txIds.push(["AddCredits", addCreditsResult.txid]);
        } else {
            console.log(\`AddCredits FAILED: \${addCreditsResult.error}\`);
        }


        // =========================================================
        // WaitForCredits (WaitForCredits)
        // =========================================================
        console.log("Waiting for credits >= 1000...");
        await pollForCredits(client, generateKeysLid, 1000);
        console.log("Credits reached");


        // =========================================================
        // CreateIdentity (Action: CreateIdentity)
        // =========================================================
        const createIdentityUrl = \`acc://\${adi_name}.acme\`;
        const createIdentitySigner = new SmartSigner(client, generateKeysKp.toKey(), generateKeysLid);
        const createIdentityResult = await createIdentitySigner.signSubmitAndWait(
            generateKeysLta,
            TxBody.createIdentity(
                createIdentityUrl,
                \`\${createIdentityUrl}/book\`,
                generateKeysPubHash,
            ),
        );
        if (createIdentityResult.success) {
            console.log(\`CreateIdentity SUCCESS - TxID: \${createIdentityResult.txid}\`);
            if (createIdentityResult.txid) txIds.push(["CreateIdentity", createIdentityResult.txid]);
        } else {
            console.log(\`CreateIdentity FAILED: \${createIdentityResult.error}\`);
        }


        // =========================================================
        // AddCredits (Action: AddCredits)
        // =========================================================
        const addAdiCreditsOracle = await client.getOraclePrice();
        const addAdiCreditsSigner = new SmartSigner(client, generateKeysKp.toKey(), generateKeysLid);
        const addAdiCreditsResult = await addAdiCreditsSigner.signSubmitAndWait(
            generateKeysLta,
            TxBody.addCredits(
                \`\${createIdentityUrl}/book/1\`,
                "500000000",
                addAdiCreditsOracle,
            ),
        );
        if (addAdiCreditsResult.success) {
            console.log(\`AddCredits SUCCESS - TxID: \${addAdiCreditsResult.txid}\`);
            if (addAdiCreditsResult.txid) txIds.push(["AddCredits", addAdiCreditsResult.txid]);
        } else {
            console.log(\`AddCredits FAILED: \${addAdiCreditsResult.error}\`);
        }


        // =========================================================
        // WaitForCredits (WaitForCredits)
        // =========================================================
        console.log("Waiting for credits >= 1000...");
        await pollForCredits(client, \`\${createIdentityUrl}/book/1\`, 1000);
        console.log("Credits reached");


        // =========================================================
        // CreateTokenAccount (Action: CreateTokenAccount)
        // =========================================================
        const createSenderAccountUrl = \`acc://\${adi_name}.acme/htlc-sender\`;
        const createSenderAccountSigner = new SmartSigner(client, generateKeysKp.toKey(), \`\${createIdentityUrl}/book/1\`);
        const createSenderAccountResult = await createSenderAccountSigner.signSubmitAndWait(
            createIdentityUrl,
            TxBody.createTokenAccount(
                \`acc://\${adi_name}.acme/htlc-sender\`,
                "acc://ACME",
            ),
        );
        if (createSenderAccountResult.success) {
            console.log(\`CreateTokenAccount SUCCESS - TxID: \${createSenderAccountResult.txid}\`);
            if (createSenderAccountResult.txid) txIds.push(["CreateTokenAccount", createSenderAccountResult.txid]);
        } else {
            console.log(\`CreateTokenAccount FAILED: \${createSenderAccountResult.error}\`);
        }


        // =========================================================
        // CreateTokenAccount (Action: CreateTokenAccount)
        // =========================================================
        const createReceiverAccountUrl = \`acc://\${adi_name}.acme/htlc-receiver\`;
        const createReceiverAccountSigner = new SmartSigner(client, generateKeysKp.toKey(), \`\${createIdentityUrl}/book/1\`);
        const createReceiverAccountResult = await createReceiverAccountSigner.signSubmitAndWait(
            createIdentityUrl,
            TxBody.createTokenAccount(
                \`acc://\${adi_name}.acme/htlc-receiver\`,
                "acc://ACME",
            ),
        );
        if (createReceiverAccountResult.success) {
            console.log(\`CreateTokenAccount SUCCESS - TxID: \${createReceiverAccountResult.txid}\`);
            if (createReceiverAccountResult.txid) txIds.push(["CreateTokenAccount", createReceiverAccountResult.txid]);
        } else {
            console.log(\`CreateTokenAccount FAILED: \${createReceiverAccountResult.error}\`);
        }


        // =========================================================
        // SendTokens (Action: SendTokens)
        // =========================================================
        const fundSenderSigner = new SmartSigner(client, generateKeysKp.toKey(), generateKeysLid);
        const fundSenderResult = await fundSenderSigner.signSubmitAndWait(
            generateKeysLta,
            TxBody.sendTokensSingle(
                createSenderAccountUrl,
                "500000000",
            ),
        );
        if (fundSenderResult.success) {
            console.log(\`SendTokens SUCCESS - TxID: \${fundSenderResult.txid}\`);
            if (fundSenderResult.txid) txIds.push(["SendTokens", fundSenderResult.txid]);
        } else {
            console.log(\`SendTokens FAILED: \${fundSenderResult.error}\`);
        }


        // =========================================================
        // WaitForBalance (WaitForBalance)
        // =========================================================
        console.log("Waiting for balance >= 1.00000000...");
        await pollForBalance(client, createSenderAccountUrl, 1.00000000);
        console.log("Balance reached");


        // =========================================================
        // GenerateHashLock (GenerateHashLock)
        // =========================================================
        // The lock is a hash of a secret preimage. The preimage stays with you until the
        // release transaction reveals it on-chain.
        const createHashLockPreimage = randomBytes(32).toString("hex");
        const createHashLockHash = requireHex("hash", createHash("sha256").update(Buffer.from(createHashLockPreimage, "hex")).digest("hex"), 32, 32);
        const createHashLockHashAlgorithm = "sha256";
        // Whole seconds in UTC: the node needs 10 minutes to 30 days of headroom and rejects fractions
        const createHashLockExpiration = Math.floor(Date.now() / 1000) + 30 * 60;
        const createHashLockExpirationIso = new Date(createHashLockExpiration * 1000).toISOString().replace(".000Z", "Z");
        const createHashLockLock = TxBody.hashLock(core.HashAlgorithm.SHA256, createHashLockHash, new Date(createHashLockExpiration * 1000));
        helpers.validateHashLockForSubmit(createHashLockLock);
        console.log("Hash lock ready:");
        console.log(\`  algorithm: \${createHashLockHashAlgorithm}\`);
        console.log(\`  hash:      \${createHashLockHash}\`);
        console.log(\`  expires:   \${createHashLockExpirationIso}\`);
        console.log(\`  PREIMAGE:  \${createHashLockPreimage}\`);


        // =========================================================
        // SendTokens (SendTokens, hash-locked)
        // =========================================================
        // Hash-locked send: the sender is debited now and the recipient is credited only
        // when a ReleaseLockedOperation reveals the preimage.
        const lockedSendSigner = new SmartSigner(client, generateKeysKp.toKey(), \`\${createIdentityUrl}/book/1\`);
        const lockedSendTxId = await submitAndConfirm(
            client,
            "SendTokens (hash-locked)",
            lockedSendSigner,
            createSenderAccountUrl,
            TxBody.sendTokensSingle(
                createReceiverAccountUrl,
                lock_amount,
            ),
            { hashLock: createHashLockLock },
        );
        console.log(\`SendTokens LOCKED - TxID: \${lockedSendTxId}\`);
        txIds.push(["SendTokens (hash-locked)", lockedSendTxId]);


        // =========================================================
        // WaitForLockedDeposit (WaitForLockedDeposit)
        // =========================================================
        // A release targets the locked DEPOSIT, not the send. The deposit is one of the
        // send's produced transactions. A query error just means it is not ready yet, and
        // \`produced.total\` can over-count, so scan the records themselves.
        const waitForLockedDepositSendTxId = lockedSendTxId;
        let waitForLockedDepositLockedTxId = null;
        console.log(\`Waiting for the locked deposit produced by \${waitForLockedDepositSendTxId}...\`);
        for (let attempt = 1; attempt <= 60 && !waitForLockedDepositLockedTxId; attempt++) {
            try {
                const sendRec = await v3Query(client, waitForLockedDepositSendTxId);
                for (const rec of sendRec.produced?.records ?? []) {
                    if (!rec.value) continue;
                    try {
                        const dep = await v3Query(client, rec.value);
                        if (dep.message?.transaction?.body?.type === "syntheticLockedDeposit" && dep.status === "delivered") {
                            waitForLockedDepositLockedTxId = rec.value;
                            break;
                        }
                    } catch {
                        // produced id not found yet
                    }
                }
            } catch {
                // send not queryable yet
            }
            if (!waitForLockedDepositLockedTxId) {
                console.log(\`  Waiting for locked deposit... (attempt \${attempt}/60)\`);
                await sleep(2000);
            }
        }
        if (!waitForLockedDepositLockedTxId) fail("the locked deposit was not delivered in time");
        console.log(\`Locked deposit: \${waitForLockedDepositLockedTxId}\`);
        txIds.push(["LockedDeposit", waitForLockedDepositLockedTxId]);


        // =========================================================
        // ReleaseLockedOperation (ReleaseLockedOperation)
        // =========================================================
        // The RECIPIENT account releases the deposit and pays the small fee, so the signer
        // needs credits. A wrong preimage or an expired lock is accepted at submit and only
        // fails when the transaction executes; submitAndConfirm checks the final status.
        const releaseLockedSigner = new SmartSigner(client, generateKeysKp.toKey(), \`\${createIdentityUrl}/book/1\`);
        const releaseLockedPreimage = requireHex("preimage", createHashLockPreimage, 1, 256);
        const releaseLockedTxId = await submitAndConfirm(
            client,
            "ReleaseLockedOperation",
            releaseLockedSigner,
            createReceiverAccountUrl,
            TxBody.releaseLockedOperation(waitForLockedDepositLockedTxId, releaseLockedPreimage),
        );
        console.log(\`ReleaseLockedOperation SUCCESS - TxID: \${releaseLockedTxId}\`);
        txIds.push(["ReleaseLockedOperation", releaseLockedTxId]);


        // =========================================================
        // WaitForBalance (WaitForBalance)
        // =========================================================
        console.log("Waiting for balance >= 1.00000000...");
        await pollForBalance(client, createReceiverAccountUrl, 1.00000000);
        console.log("Balance reached");


        console.log("\\n========== Transaction Summary ==========");
        for (const [label, txid] of txIds) {
            console.log(\`  \${label}: \${txid}\`);
        }
        console.log("Flow completed successfully!");
    } catch (err) {
        console.error("Flow failed:", err);
    }
}

main().catch(console.error);
"
`;

