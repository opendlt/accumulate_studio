exports[`Codegen Snapshots > csharp SDK > zero-to-hero generates expected csharp code 1`] = `
"// Zero to Hero: From Nothing to ADI
// Generated by Accumulate Studio
// Network: devnet
//
// NuGet packages:
//   dotnet add package Acme.Net.Sdk
//
// Run with: dotnet run

using System;
using System.Collections.Generic;
using System.Security.Cryptography;
using System.Text.Json;
using System.Threading.Tasks;
using Acme.Net.Sdk;
using Acme.Net.Sdk.Protocol;
using Acme.Net.Sdk.Protocol.Generated;
using Acme.Net.Sdk.Signing;
using Acme.Net.Sdk.Transactions;
using Acme.Net.Sdk.Helpers;

class Program
{
    static async Task Main(string[] args)
    {
        var baseUrl = Environment.GetEnvironmentVariable("ACCUMULATE_BASE_URL")
            ?? "https://kermit.accumulatenetwork.io";
        using var client = new Accumulate(baseUrl);
        var helper = new AccumulateHelper(client);
        var txIds = new List<(string Label, string TxId)>();
        try
        {
            // Flow variables (customize these for your use case)
            var adi_name = $"adi-{DateTimeOffset.UtcNow.ToUnixTimeSeconds()}-{Random.Shared.Next(0x1000000):x6}";  // 
            var token_account_name = "";  // 


            // =========================================================
            // GenerateKeys (GenerateKeys)
            // =========================================================
            var generateKeysKp = AccKeyPairGenerator.GenerateSignatureKeyPair(SignatureType.ED25519);
            var generateKeysLid = Principal.ComputeUrl(generateKeysKp.GetPublicKey());
            var generateKeysLta = Principal.ComputeUrl(generateKeysKp.GetPublicKey(), new Url("acc://ACME"));
            var generateKeysPubKey = generateKeysKp.GetPublicKey();
            var generateKeysPubHash = Convert.ToHexString(SHA256.HashData(generateKeysPubKey)).ToLowerInvariant();
            Console.WriteLine("Generated keypair:");
            Console.WriteLine($"  Lite Identity: {generateKeysLid}");
            Console.WriteLine($"  Lite Token Account: {generateKeysLta}");
            Console.WriteLine($"  Public Key Hash: {generateKeysPubHash}");


            // =========================================================
            // Faucet (Faucet)
            // =========================================================
            Console.WriteLine("Requesting tokens from faucet...");
            for (int i = 0; i < 2; i++)
            {
                try
                {
                    var resp = await client.V2.FaucetAsync(generateKeysLta.String());
                    Console.WriteLine($"  Faucet {i + 1}/2: submitted");
                    await Task.Delay(2000);
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"  Faucet {i + 1}/2 failed: {ex.Message}");
                }
            }
            Console.WriteLine("Faucet request completed");


            // =========================================================
            // WaitForBalance (WaitForBalance)
            // =========================================================
            Console.WriteLine("Waiting for balance >= 10.00000000...");
            await helper.PollForBalanceAsync(generateKeysLta.String());
            Console.WriteLine("Balance reached");


            // =========================================================
            // AddCredits (Action: AddCredits)
            // =========================================================
            var addCreditsOracle = await helper.GetOracleAsync();
            var addCreditsSigner = new SmartSigner(client.V3, generateKeysKp, generateKeysLid.String());
            var addCreditsResult = await addCreditsSigner.SignSubmitAndWaitAsync(
                generateKeysLta.String(),
                TxBody.AddCredits(
                    generateKeysLid.String(),
                    "500000000",
                    addCreditsOracle
                )
            );
            if (addCreditsResult.Success)
            {
                Console.WriteLine($"AddCredits SUCCESS - TxID: {addCreditsResult.TxId}");
                if (addCreditsResult.TxId != null) txIds.Add(("AddCredits", addCreditsResult.TxId));
            }
            else
            {
                Console.WriteLine($"AddCredits FAILED: {addCreditsResult.Error}");
            }


            // =========================================================
            // WaitForCredits (WaitForCredits)
            // =========================================================
            Console.WriteLine("Waiting for credits >= 1000...");
            await helper.PollForCreditsAsync(generateKeysLid.String());
            Console.WriteLine("Credits reached");


            // =========================================================
            // CreateIdentity (Action: CreateIdentity)
            // =========================================================
            var createIdentityUrl = $"acc://{adi_name}.acme";
            var createIdentitySigner = new SmartSigner(client.V3, generateKeysKp, generateKeysLid.String());
            var createIdentityResult = await createIdentitySigner.SignSubmitAndWaitAsync(
                generateKeysLid.String(),
                TxBody.CreateIdentity(
                    createIdentityUrl,
                    $"{createIdentityUrl}/book",
                    generateKeysPubHash
                )
            );
            if (createIdentityResult.Success)
            {
                Console.WriteLine($"CreateIdentity SUCCESS - TxID: {createIdentityResult.TxId}");
                if (createIdentityResult.TxId != null) txIds.Add(("CreateIdentity", createIdentityResult.TxId));
            }
            else
            {
                Console.WriteLine($"CreateIdentity FAILED: {createIdentityResult.Error}");
            }


            // =========================================================
            // CreateTokenAccount (Action: CreateTokenAccount)
            // =========================================================
            var createTokenAccountUrl = $"acc://{adi_name}.acme/{token_account_name}";
            var createTokenAccountSigner = new SmartSigner(client.V3, generateKeysKp, $"{createIdentityUrl}/book/1");
            var createTokenAccountResult = await createTokenAccountSigner.SignSubmitAndWaitAsync(
                $"acc://{adi_name}.acme",
                TxBody.CreateTokenAccount(
                    $"acc://{adi_name}.acme/{token_account_name}",
                    "acc://ACME"
                )
            );
            if (createTokenAccountResult.Success)
            {
                Console.WriteLine($"CreateTokenAccount SUCCESS - TxID: {createTokenAccountResult.TxId}");
                if (createTokenAccountResult.TxId != null) txIds.Add(("CreateTokenAccount", createTokenAccountResult.TxId));
            }
            else
            {
                Console.WriteLine($"CreateTokenAccount FAILED: {createTokenAccountResult.Error}");
            }


            Console.WriteLine("\\n========== Transaction Summary ==========");
            foreach (var (label, txid) in txIds)
            {
                Console.WriteLine($"  {label}: {txid}");
            }
            Console.WriteLine("Flow completed successfully!");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Flow failed: {ex.Message}");
        }
    }
}
"
`;

