exports[`Codegen Snapshots > javascript SDK > zero-to-hero generates expected javascript code 1`] = `
"/**
 * Zero to Hero: From Nothing to ADI
 * Generated by Accumulate Studio
 * Network: devnet
 *
 * Install: npm install accumulate-sdk-opendlt
 * Run with: node script.mjs
 */

import {
    Accumulate,
    SmartSigner,
    TxBody,
    Ed25519KeyPair,
    KERMIT_V2,
    KERMIT_V3,
    pollForBalance,
    pollForCredits,
} from "accumulate-sdk-opendlt";

const V2_ENDPOINT = process.env.ACCUMULATE_V2_URL || KERMIT_V2;
const V3_ENDPOINT = process.env.ACCUMULATE_V3_URL || KERMIT_V3;

async function main() {
    const client = Accumulate.custom(V2_ENDPOINT, V3_ENDPOINT);
    const txIds = [];
    try {
        const adi_name = \`adi-\${Math.floor(Date.now() / 1000)}\`;  // 
        const token_account_name = "";  // 


        // =========================================================
        // GenerateKeys (GenerateKeys)
        // =========================================================
        const generateKeysKp = Ed25519KeyPair.generate();
        const generateKeysLid = generateKeysKp.deriveLiteIdentityUrl();
        const generateKeysLta = generateKeysKp.deriveLiteTokenAccountUrl();
        const generateKeysPubHash = generateKeysKp.publicKeyHashHex();
        console.log("Generated keypair:");
        console.log(\`  Lite Identity: \${generateKeysLid}\`);
        console.log(\`  Lite Token Account: \${generateKeysLta}\`);
        console.log(\`  Public Key Hash: \${generateKeysPubHash}\`);


        // =========================================================
        // Faucet (Faucet)
        // =========================================================
        console.log("Requesting tokens from faucet...");
        await client.faucet(generateKeysLta, 2, 2000);
        console.log("Faucet request completed");


        // =========================================================
        // WaitForBalance (WaitForBalance)
        // =========================================================
        console.log("Waiting for balance >= 10.00000000...");
        await pollForBalance(client, generateKeysLta, 10.00000000);
        console.log("Balance reached");


        // =========================================================
        // AddCredits (Action: AddCredits)
        // =========================================================
        const addCreditsOracle = await client.getOraclePrice();
        const addCreditsSigner = new SmartSigner(client, generateKeysKp.toKey(), generateKeysLid);
        const addCreditsResult = await addCreditsSigner.signSubmitAndWait(
            generateKeysLta,
            TxBody.addCredits(
                generateKeysLid,
                "500000000",
                addCreditsOracle,
            ),
        );
        if (addCreditsResult.success) {
            console.log(\`AddCredits SUCCESS - TxID: \${addCreditsResult.txid}\`);
            if (addCreditsResult.txid) txIds.push(["AddCredits", addCreditsResult.txid]);
        } else {
            console.log(\`AddCredits FAILED: \${addCreditsResult.error}\`);
        }


        // =========================================================
        // WaitForCredits (WaitForCredits)
        // =========================================================
        console.log("Waiting for credits >= 1000...");
        await pollForCredits(client, generateKeysLid, 1000);
        console.log("Credits reached");


        // =========================================================
        // CreateIdentity (Action: CreateIdentity)
        // =========================================================
        const createIdentityUrl = \`acc://\${adi_name}.acme\`;
        const createIdentitySigner = new SmartSigner(client, generateKeysKp.toKey(), generateKeysLid);
        const createIdentityResult = await createIdentitySigner.signSubmitAndWait(
            generateKeysLid,
            TxBody.createIdentity(
                createIdentityUrl,
                \`\${createIdentityUrl}/book\`,
                generateKeysPubHash,
            ),
        );
        if (createIdentityResult.success) {
            console.log(\`CreateIdentity SUCCESS - TxID: \${createIdentityResult.txid}\`);
            if (createIdentityResult.txid) txIds.push(["CreateIdentity", createIdentityResult.txid]);
        } else {
            console.log(\`CreateIdentity FAILED: \${createIdentityResult.error}\`);
        }


        // =========================================================
        // CreateTokenAccount (Action: CreateTokenAccount)
        // =========================================================
        const createTokenAccountUrl = \`acc://\${adi_name}.acme/\${token_account_name}\`;
        const createTokenAccountSigner = new SmartSigner(client, generateKeysKp.toKey(), \`\${createIdentityUrl}/book/1\`);
        const createTokenAccountResult = await createTokenAccountSigner.signSubmitAndWait(
            \`acc://\${adi_name}.acme\`,
            TxBody.createTokenAccount(
                \`acc://\${adi_name}.acme/\${token_account_name}\`,
                "acc://ACME",
            ),
        );
        if (createTokenAccountResult.success) {
            console.log(\`CreateTokenAccount SUCCESS - TxID: \${createTokenAccountResult.txid}\`);
            if (createTokenAccountResult.txid) txIds.push(["CreateTokenAccount", createTokenAccountResult.txid]);
        } else {
            console.log(\`CreateTokenAccount FAILED: \${createTokenAccountResult.error}\`);
        }


        console.log("\\n========== Transaction Summary ==========");
        for (const [label, txid] of txIds) {
            console.log(\`  \${label}: \${txid}\`);
        }
        console.log("Flow completed successfully!");
    } catch (err) {
        console.error("Flow failed:", err);
    }
}

main().catch(console.error);
"
`;

exports[`Codegen Snapshots > python SDK > adi-creation generates expected python code 1`] = `
"#!/usr/bin/env python3
"""
Full ADI Creation
=================

Generated by Accumulate Studio
Network: devnet
"""

import time

from accumulate_client import Accumulate, NetworkStatusOptions
from accumulate_client.convenience import TxBody, SmartSigner
from accumulate_client.crypto.ed25519 import Ed25519KeyPair
import hashlib
import requests as _requests_lib

# Network endpoints
NETWORK_ENDPOINT = "https://devnet.accumulatenetwork.io"
# For local DevNet testing, uncomment:
# NETWORK_ENDPOINT = "http://127.0.0.1:26660"


def fund_account(client, account_url, faucet_requests=1):
    """Fund an account using the testnet faucet with retry logic."""
    v2_endpoint = client.v2.endpoint
    print(f"Requesting funds from faucet ({faucet_requests} times)...")
    for i in range(faucet_requests):
        try:
            response = _requests_lib.post(
                v2_endpoint,
                json={
                    "jsonrpc": "2.0",
                    "method": "faucet",
                    "params": {"url": account_url},
                    "id": i + 1,
                },
                timeout=30,
            )
            result = response.json()
            txid = result.get("result", {}).get("txid", "submitted")
            print(f"  Faucet {i+1}/{faucet_requests}: {str(txid)[:40]}...")
            time.sleep(2)
        except Exception as e:
            print(f"  Faucet {i+1}/{faucet_requests} failed: {e}")


def poll_for_balance(client, account_url, min_balance=1, max_attempts=30):
    """Poll until account balance meets minimum threshold."""
    for i in range(max_attempts):
        try:
            result = client.v3.query(account_url)
            balance = result.get("account", {}).get("balance")
            if balance is not None:
                balance_int = int(balance) if isinstance(balance, (int, str)) else 0
                if balance_int > 0 and balance_int >= min_balance:
                    return balance_int
            print(f"  Waiting for balance... (attempt {i+1}/{max_attempts})")
        except Exception:
            pass
        time.sleep(2)
    return 0


def poll_for_credits(client, account_url, min_credits=1, max_attempts=30):
    """Poll until account credit balance meets minimum threshold."""
    for i in range(max_attempts):
        try:
            result = client.v3.query(account_url)
            credits = result.get("account", {}).get("creditBalance", 0)
            if int(credits) > 0 and int(credits) >= min_credits:
                return int(credits)
            print(f"  Waiting for credits... (attempt {i+1}/{max_attempts})")
        except Exception:
            pass
        time.sleep(2)
    return 0


def main():
    """
    Full ADI Creation
    Creates a complete Accumulate Digital Identity (ADI) with proper key management structure. Includes a key book with an initial key page. This is the standard way to set up an ADI for production use.

    Generated by Accumulate Studio
    """

    # Connect to the network
    client = Accumulate(NETWORK_ENDPOINT)
    tx_ids = []

    # Flow variables (customize these for your use case)
    adi_name = f"adi-{int(time.time())}"  # 
    key_book_name = ""  # 

    try:


        # =========================================================
        # GenerateKeys (Action: GenerateKeys)
        # =========================================================
        generate_keys_kp = Ed25519KeyPair.generate()
        generate_keys_lid = generate_keys_kp.derive_lite_identity_url()
        generate_keys_lta = generate_keys_kp.derive_lite_token_account_url("ACME")
        generate_keys_pub_hash = hashlib.sha256(generate_keys_kp.public_key_bytes()).hexdigest()
        print(f"Generated keypair:")
        print(f"  Lite Identity: {generate_keys_lid}")
        print(f"  Lite Token Account: {generate_keys_lta}")

        # =========================================================
        # Faucet (Action: Faucet)
        # =========================================================
        fund_account(client, str(generate_keys_lta), faucet_requests=3)
        print("Faucet request completed")

        # =========================================================
        # WaitForBalance (Action: WaitForBalance)
        # =========================================================
        print("Waiting for balance >= 15.00000000...")
        _balance = poll_for_balance(client, str(generate_keys_lta), min_balance=15.00000000)
        if _balance == 0:
            print("ERROR: Balance did not reach minimum. Stopping.")
            return
        print(f"Balance confirmed: {_balance}")

        # =========================================================
        # AddCredits (Action: AddCredits)
        # =========================================================
        add_credits_oracle = client.v3.network_status(
            NetworkStatusOptions(partition="directory")
        ).get("oracle", {}).get("price", 500000)
        print(f"Oracle price: {add_credits_oracle}")
        add_credits_signer = SmartSigner(client.v3, generate_keys_kp, generate_keys_lid)
        add_credits_result = add_credits_signer.sign_submit_and_wait(
            principal=str(generate_keys_lta),
            body=TxBody.add_credits(
                recipient=str(generate_keys_lid),
                amount="1000000000",
                oracle=add_credits_oracle,
            ),
            max_attempts=30,
        )
        if add_credits_result.success:
            print(f"AddCredits SUCCESS - TxID: {add_credits_result.txid}")
            tx_ids.append(("AddCredits", add_credits_result.txid))
        else:
            print(f"AddCredits FAILED: {add_credits_result.error}")

        # =========================================================
        # CreateIdentity (Action: CreateIdentity)
        # =========================================================
        create_identity_url = f"acc://{adi_name}.acme"
        create_identity_signer = SmartSigner(client.v3, generate_keys_kp, generate_keys_lid)
        create_identity_result = create_identity_signer.sign_submit_and_wait(
            principal=str(generate_keys_lta),
            body=TxBody.create_identity(
                url=create_identity_url,
                key_book_url=f"{create_identity_url}/book",
                public_key_hash=generate_keys_pub_hash,
            ),
            max_attempts=30,
        )
        if create_identity_result.success:
            print(f"CreateIdentity SUCCESS - TxID: {create_identity_result.txid}")
            tx_ids.append(("CreateIdentity", create_identity_result.txid))
        else:
            print(f"CreateIdentity FAILED: {create_identity_result.error}")

        # =========================================================
        # CreateKeyBook (Action: CreateKeyBook)
        # =========================================================
        create_key_book_url = f"acc://{adi_name}.acme/admin-book"
        create_key_book_signer = SmartSigner(client.v3, generate_keys_kp, f"{str(create_identity_url)}/book/1")
        create_key_book_result = create_key_book_signer.sign_submit_and_wait(
            principal=f"acc://{adi_name}.acme",
            body=TxBody.create_key_book(
                url=create_key_book_url,
                public_key_hash=generate_keys_pub_hash,
            ),
            max_attempts=30,
        )
        if create_key_book_result.success:
            print(f"CreateKeyBook SUCCESS - TxID: {create_key_book_result.txid}")
            tx_ids.append(("CreateKeyBook", create_key_book_result.txid))
        else:
            print(f"CreateKeyBook FAILED: {create_key_book_result.error}")

        # =========================================================
        # CreateKeyPage (Action: CreateKeyPage)
        # =========================================================
        create_key_page_signer = SmartSigner(client=client.v3, keypair=generate_keys_kp, signer_url=str(generate_keys_lta))
        create_key_page_result = create_key_page_signer.sign_submit_and_wait(
            principal=f"acc://{adi_name}.acme/admin-book",
            body=TxBody.create_key_page(
                keys=[
                    {"keyHash": generate_keys_pub_hash },
                ],
            ),
            max_attempts=30,
        )
        if create_key_page_result.success:
            print(f"CreateKeyPage SUCCESS - TxID: {create_key_page_result.txid}")
            tx_ids.append(("CreateKeyPage", create_key_page_result.txid))
        else:
            print(f"CreateKeyPage FAILED: {create_key_page_result.error}")

        # =========================================================
        # Summary
        # =========================================================
        print("\\n=== TRANSACTION IDs FOR VERIFICATION ===\\n")
        for tx_name, txid in tx_ids:
            print(f"  {tx_name}: {txid}")
        print(f"\\nTotal transactions: {len(tx_ids)}")
        print("Flow completed successfully!")

    finally:
        client.close()


if __name__ == "__main__":
    main()
"
`;

